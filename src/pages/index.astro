---
import Header from "@/components/Header.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Hero from "@/sections/Hero.astro";
import About from "@/sections/About.astro";
import Footer from "@/components/Footer.astro";
import Contact from "@/sections/Contact.astro";
import Services from "@/sections/Services.astro";
import Work from "@/sections/Work.astro";
---

<Layout>
  <Header />

  <main id="portfolio-sections" class="relative bg-black overflow-x-clip">
    <!-- 1. Hero (Black): Pins so About slides up in front of it -->
    <div id="hero-wrapper" class="relative z-10 bg-black overflow-hidden">
      <Hero />
    </div>

    <!-- 2. About (White): Slides over Hero, then scrolls normally into Work -->
    <div id="about-wrapper" class="relative z-20 bg-white overflow-hidden">
      <About />
    </div>

    <!-- 3. Work (Black): Scrolls normally, then pins at bottom so Services slides up in front of it -->
    <div id="work-wrapper" class="relative z-30 bg-black overflow-hidden">
      <Work />
    </div>

    <!-- 4. Services (White): Slides straight up in front of Work -->
    <div id="services-wrapper" class="relative z-40 bg-white overflow-hidden">
      <Services />
    </div>

    <!-- 5. Contact + Footer (Black): Grounded stage reveal -->
    <div id="contact-wrapper" class="relative z-40 bg-black overflow-hidden">
      <div id="contact-inner" class="will-change-transform">
        <Contact />
        <Footer />
      </div>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let sectionTransitions: ScrollTrigger[] = [];

  function initSectionTransitions() {
    sectionTransitions.forEach((st) => st.kill());
    sectionTransitions = [];

    const heroWrapper = document.getElementById("hero-wrapper");
    const aboutWrapper = document.getElementById("about-wrapper");
    const workWrapper = document.getElementById("work-wrapper");
    const servicesWrapper = document.getElementById("services-wrapper");
    const contactWrapper = document.getElementById("contact-wrapper");
    const contactInner = document.getElementById("contact-inner");

    if (!heroWrapper || !aboutWrapper || !workWrapper || !servicesWrapper) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set([heroWrapper, aboutWrapper, workWrapper, servicesWrapper, contactInner], {
        clearProps: "all",
      });
      return;
    }

    // 1. HERO -> ABOUT: Pin Hero so About slides straight up in front of it
    const heroPin = ScrollTrigger.create({
      trigger: heroWrapper,
      start: () =>
        heroWrapper.offsetHeight > window.innerHeight ? "bottom bottom" : "top top",
      end: () => `+=${aboutWrapper.offsetHeight}`,
      pin: true,
      pinSpacing: false,
      invalidateOnRefresh: true,
    });
    sectionTransitions.push(heroPin);

    // 2. ABOUT -> WORK: Normal vertical scroll (no pin on About)

    // 3. WORK -> SERVICES: Pin Work at its bottom edge so Services slides straight up in front of it
    const workPin = ScrollTrigger.create({
      trigger: workWrapper,
      start: () =>
        workWrapper.offsetHeight > window.innerHeight ? "bottom bottom" : "top top",
      end: () => `+=${Math.min(servicesWrapper.offsetHeight, window.innerHeight)}`,
      pin: true,
      pinSpacing: false,
      invalidateOnRefresh: true,
    });
    sectionTransitions.push(workPin);

    // 4. SERVICES -> CONTACT + FOOTER: Subtle stage-reveal parallax settle
    if (contactWrapper && contactInner) {
      gsap.set(contactInner, { yPercent: -10 });

      const contactTween = gsap.to(contactInner, {
        yPercent: 0,
        ease: "none",
        scrollTrigger: {
          trigger: contactWrapper,
          start: "top bottom",
          end: "top 30%",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
      if (contactTween.scrollTrigger) sectionTransitions.push(contactTween.scrollTrigger);
    }

    ScrollTrigger.refresh();
  }

  if (document.readyState === "complete") {
    initSectionTransitions();
  } else {
    window.addEventListener("load", initSectionTransitions, { once: true });
  }
  document.addEventListener("astro:page-load", initSectionTransitions);
</script>