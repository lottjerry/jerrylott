---
// src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
import DotGrid from "@/components/DotGrid.astro";
import "@/styles/global.css";

const titleWords = ["PAGE", "NOT", "FOUND."];
---

<Layout>
  <main
    id="error-404"
    class="min-h-dvh bg-black text-white font-sans flex flex-col justify-between py-8 md:py-10 px-6 md:px-12 overflow-hidden"
  >
    <!-- Top Section Index Header -->
    <header class="w-full">
      <div class="relative flex justify-between items-center pb-5 font-mono font-bold text-xs">
        <div class="flex gap-5">
          <p class="err-header-item">[ 404 ]</p>
          <p class="err-header-item">/not-found</p>
        </div>
        <p class="err-header-item opacity-50 hidden sm:block">
          STATUS // HTTP_404_MISSING_RESOURCE
        </p>
        <span
          id="err-header-line"
          class="absolute bottom-0 left-0 right-0 h-px bg-white origin-left"
        ></span>
      </div>
    </header>

    <!-- Center Editorial Stage -->
    <div class="w-full lg:w-[88%] mx-auto my-auto py-10 flex flex-col lg:flex-row lg:items-end justify-between gap-12">
      <!-- Left Column: Stacked Slam Typography -->
      <div class="flex flex-col gap-6 md:gap-8">
        <h1
          aria-label="PAGE NOT FOUND."
          class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-sans font-black leading-[0.98] tracking-tight"
        >
          {titleWords.map((word) => (
            <span class="block overflow-hidden py-1">
              <span class="err-title-line block will-change-transform">
                {word}
              </span>
            </span>
          ))}
        </h1>

        <div id="err-dots" class="overflow-hidden max-w-full opacity-60">
          <DotGrid rows={4} cols={70} gap="gap-1" />
        </div>
      </div>

      <!-- Right Column: Diagnostic Details & Return Actions -->
      <div class="flex flex-col gap-8 max-w-md font-mono">
        <div class="err-detail flex flex-col gap-3 border-l border-white/30 pl-5">
          <p class="text-xs font-bold tracking-widest opacity-50">
            [ DIAGNOSTIC ]
          </p>
          <p class="font-sans text-base md:text-lg font-normal leading-relaxed text-white/90">
            The route you requested doesn't exist, was moved during a build, or never shipped to production.
          </p>
          <p class="text-xs text-white/60 break-all">
            REQUESTED PATH: <span id="err-bad-path" class="text-white font-bold">/unknown</span>
          </p>
        </div>

        <div class="err-detail flex flex-col gap-4">
          <p class="text-xs font-bold tracking-widest opacity-50">
            [ NAVIGATION ]
          </p>

          <div class="flex flex-wrap items-center gap-6 text-sm md:text-base font-bold">
            <a
              href="/"
              data-target="#"
              class="err-nav-link relative pb-1 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-100 after:bg-white after:transition-transform after:duration-300 hover:opacity-70"
            >
              [ ← RETURN HOME ]
            </a>

            <a
              href="/"
              data-target="#work"
              class="err-nav-link relative pb-1 opacity-70 hover:opacity-100 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
            >
              /work
            </a>

            <a
              href="/"
              data-target="#contact"
              class="err-nav-link relative pb-1 opacity-70 hover:opacity-100 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
            >
              /contact
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Rule -->
    <footer class="relative w-full pt-6 font-mono text-[0.625rem] md:text-xs font-bold flex flex-col sm:flex-row justify-between items-center gap-3 text-white/70">
      <span
        id="err-footer-line"
        class="absolute top-0 left-0 right-0 h-px bg-white/30 origin-center"
      ></span>
      <p class="err-footer-item">© 2026 JERRY LOTT. ALL RIGHTS RESERVED.</p>
      <p class="err-footer-item">D4 STUDIO // ERROR_RECOVERY</p>
    </footer>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";

  function init404Page() {
    const root = document.getElementById("error-404");
    if (!root) return;

    const pathEl = document.getElementById("err-bad-path");
    if (pathEl) {
      pathEl.textContent = window.location.pathname;
    }

    // Store target section in sessionStorage so URL stays "/" without #hash
    root.querySelectorAll<HTMLAnchorElement>(".err-nav-link").forEach((link) => {
      if (link.dataset.bound === "true") return;
      link.dataset.bound = "true";

      link.addEventListener("click", () => {
        const target = link.getAttribute("data-target");
        if (target && target !== "#") {
          sessionStorage.setItem("pending_section_scroll", target);
        } else {
          sessionStorage.removeItem("pending_section_scroll");
        }
      });
    });

    const headerLine = document.getElementById("err-header-line");
    const headerItems = gsap.utils.toArray<HTMLElement>("#error-404 .err-header-item");
    const titleLines = gsap.utils.toArray<HTMLElement>("#error-404 .err-title-line");
    const dots = document.getElementById("err-dots");
    const details = gsap.utils.toArray<HTMLElement>("#error-404 .err-detail");
    const footerLine = document.getElementById("err-footer-line");
    const footerItems = gsap.utils.toArray<HTMLElement>("#error-404 .err-footer-item");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set([headerLine, headerItems, titleLines, dots, details, footerLine, footerItems], {
        clearProps: "all",
      });
      return;
    }

    gsap.set(headerLine, { scaleX: 0 });
    gsap.set(headerItems, { y: 10, opacity: 0 });
    gsap.set(titleLines, { yPercent: 115, opacity: 0 });
    if (dots) gsap.set(dots, { clipPath: "inset(0% 100% 0% 0%)" });
    gsap.set(details, { y: 20, opacity: 0 });
    gsap.set(footerLine, { scaleX: 0 });
    gsap.set(footerItems, { y: 8, opacity: 0 });

    const playEntrance = () => {
      const tl = gsap.timeline({ delay: 0.05 });

      tl.to(headerLine, {
        scaleX: 1,
        duration: 0.75,
        ease: "power3.inOut",
      })
        .to(
          headerItems,
          {
            y: 0,
            opacity: 1,
            duration: 0.4,
            ease: "power3.out",
            stagger: 0.06,
          },
          "<0.15"
        )
        .to(
          titleLines,
          {
            yPercent: 0,
            opacity: 1,
            duration: 0.75,
            ease: "power4.out",
            stagger: 0.1,
            clearProps: "transform",
          },
          "-=0.45"
        );

      if (dots) {
        tl.to(
          dots,
          {
            clipPath: "inset(0% 0% 0% 0%)",
            duration: 0.7,
            ease: "power3.inOut",
          },
          "-=0.45"
        );
      }

      tl.to(
        details,
        {
          y: 0,
          opacity: 1,
          duration: 0.55,
          ease: "power3.out",
          stagger: 0.12,
          clearProps: "transform",
        },
        "-=0.5"
      )
        .to(
          footerLine,
          {
            scaleX: 1,
            duration: 0.75,
            ease: "power3.inOut",
          },
          "-=0.4"
        )
        .to(
          footerItems,
          {
            y: 0,
            opacity: 1,
            duration: 0.45,
            ease: "power3.out",
            stagger: 0.08,
          },
          "-=0.4"
        );
    };

    if (window.preloaderRevealed) {
      playEntrance();
    } else {
      window.addEventListener("preloader:reveal", playEntrance, { once: true });
    }
  }

  init404Page();
  document.addEventListener("astro:page-load", init404Page);
</script>