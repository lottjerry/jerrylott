---
// src/layouts/Layout.astro
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import Preloader from '@/components/Preloader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Jerry Lott — Full-Stack Developer, UI/UX Designer & Security Researcher',
  description = 'Portfolio of Jerry Lott — building full-stack web applications, intuitive UI/UX systems, and security-hardened software.',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageURL = new URL(image, Astro.site ?? Astro.url);
const siteOrigin = (Astro.site ?? Astro.url).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Jerry Lott',
      url: siteOrigin,
      jobTitle: 'Full-Stack Developer, UI/UX Designer & Security Researcher',
      worksFor: {
        '@type': 'Organization',
        name: 'D4 Studio',
      },
      sameAs: [
        'https://github.com/lottjerry',
        'https://www.linkedin.com/in/jerrylott',
      ],
    },
    {
      '@type': 'WebSite',
      name: 'Jerry Lott — Portfolio',
      url: siteOrigin,
    },
  ],
};
---

<!doctype html>
<html lang="en" style="background-color: #000000;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Jerry Lott" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}

    <!-- Favicons, Manifest & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Jerry Lott" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jerry Lott — Design. Develop. Deploy. Defend." />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Jerry Lott — Design. Develop. Deploy. Defend." />

    <!-- Structured Data -->
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Runs synchronously before first paint to prevent browser scroll restoration -->
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class="bg-black" style="background-color: #000000; overflow: hidden;">
    <Preloader />
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.clearScrollMemory('manual');

      declare global {
        interface Window {
          smoothScrollLenis?: Lenis;
          __scrollResetBound?: boolean;
        }
      }

      function forceScrollTop() {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        if (window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
        window.scrollTo(0, 0);
        document.documentElement.scrollTop = 0;
        document.body.scrollTop = 0;

        if (window.smoothScrollLenis) {
          window.smoothScrollLenis.scrollTo(0, { immediate: true, force: true });
        }
      }

      // Named callback so we can cleanly add/remove it on View Transitions
      function updateLenis(time: number) {
        window.smoothScrollLenis?.raf(time * 1000);
      }

      function initScroll() {
        // 1. Clean up existing Lenis, ticker listener, and ScrollTriggers
        gsap.ticker.remove(updateLenis);
        ScrollTrigger.clearScrollMemory('manual');
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

        if (window.smoothScrollLenis) {
          window.smoothScrollLenis.destroy();
          window.smoothScrollLenis = undefined;
        }

        forceScrollTop();

        // 2. Respect reduced motion (ScrollTrigger still works normally without Lenis)
        const prefersReducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        if (prefersReducedMotion) return;

        // 3. Initialize Lenis with autoRaf disabled so GSAP drives it
        const lenis = new Lenis({
          autoRaf: false,
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        window.smoothScrollLenis = lenis;

        // Snap Lenis immediately to 0 so it never inherits a mid-page scroll position
        lenis.scrollTo(0, { immediate: true, force: true });

        // Keep Lenis paused if the preloader curtain is still visible on initial load
        const curtain = document.getElementById('preloader-curtain');
        if (curtain && curtain.style.display !== 'none') {
          lenis.stop();
        }

        // 4. Sync ScrollTrigger and bind to GSAP's ticker
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add(updateLenis);
        gsap.ticker.lagSmoothing(0);
      }

      if (!window.__scrollResetBound) {
        window.__scrollResetBound = true;

        // Reset right before reload so browsers don't snapshot a mid-page offset
        window.addEventListener('beforeunload', () => {
          if (window.location.hash) {
            history.replaceState(null, '', window.location.pathname + window.location.search);
          }
          window.scrollTo(0, 0);
        });

        // Handle Safari / mobile bfcache restores
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) {
            forceScrollTop();
            ScrollTrigger.refresh();
          }
        });
      }

      initScroll();
      document.addEventListener('astro:after-swap', initScroll);
    </script>
  </body>
</html>
<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;

    /* Firefox */
    scrollbar-width: none;

    /* IE & legacy Edge */
    -ms-overflow-style: none;
  }

  /* Chrome, Safari, Opera, and Chromium Edge */
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }
</style>