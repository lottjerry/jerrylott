---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body class="bg-black">
    <slot />

    <script>
      import Lenis from 'lenis';

      declare global {
        interface Window {
          smoothScrollLenis?: Lenis;
        }
      }

      function initLenis() {
        if (window.smoothScrollLenis) {
          window.smoothScrollLenis.destroy();
          window.smoothScrollLenis = undefined;
        }

        const prefersReducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        if (prefersReducedMotion) return;

        window.smoothScrollLenis = new Lenis({
          autoRaf: true,
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
      }

      initLenis();
      document.addEventListener('astro:after-swap', initLenis);
    </script>
  </body>
</html>
<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>