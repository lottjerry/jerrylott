---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import Preloader from '@/components/Preloader.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body class="bg-black">
    <Preloader />
    <slot />

    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      declare global {
        interface Window {
          smoothScrollLenis?: Lenis;
        }
      }

      // Named callback so we can cleanly add/remove it on View Transitions
      function updateLenis(time: number) {
        window.smoothScrollLenis?.raf(time * 1000);
      }

      function initScroll() {
        // 1. Clean up existing Lenis, ticker listener, and ScrollTriggers
        gsap.ticker.remove(updateLenis);
        ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

        if (window.smoothScrollLenis) {
          window.smoothScrollLenis.destroy();
          window.smoothScrollLenis = undefined;
        }

        // 2. Respect reduced motion (ScrollTrigger still works normally without Lenis)
        const prefersReducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        if (prefersReducedMotion) return;

        // 3. Initialize Lenis with autoRaf disabled so GSAP drives it
        const lenis = new Lenis({
          autoRaf: false,
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        window.smoothScrollLenis = lenis;

        // Keep Lenis paused if the preloader curtain is still visible on initial load
        const curtain = document.getElementById('preloader-curtain');
        if (curtain && curtain.style.display !== 'none') {
          lenis.stop();
        }

        // 4. Sync ScrollTrigger and bind to GSAP's ticker
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add(updateLenis);
        gsap.ticker.lagSmoothing(0);
      }

      initScroll();
      document.addEventListener('astro:after-swap', initScroll);
    </script>
  </body>
</html>
<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;

    /* Firefox */
    scrollbar-width: none;

    /* IE & legacy Edge */
    -ms-overflow-style: none;
  }

  /* Chrome, Safari, Opera, and Chromium Edge */
  html::-webkit-scrollbar,
  body::-webkit-scrollbar {
    display: none;
  }
</style>