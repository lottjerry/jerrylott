---
// src/sections/Contact.astro
const titleWords = ["LET'S", "BUILD", "TOGETHER."];
---

<div
  id="contact"
  class="flex flex-col justify-between min-h-[90vh] bg-black text-white font-sans mb-10"
>
  <header class="p-10 w-full">
    <div class="relative flex gap-5 pb-5 font-bold">
      <p class="contact-header-item">[ 04 ]</p>
      <p class="contact-header-item">/contact</p>
      <span
        id="contact-header-line"
        class="absolute bottom-0 left-0 right-0 h-px bg-white origin-left"
      ></span>
    </div>
  </header>

  <div class="flex flex-col gap-10 md:gap-16 lg:flex-row lg:justify-around justify-between my-auto py-10">
    <!-- Left Column: Title & Availability -->
    <div class="flex flex-col px-10 gap-10 md:px-14 md:gap-14">
      <h1
        aria-label="LET'S BUILD TOGETHER."
        class="text-5xl font-sans font-black md:text-8xl lg:text-9xl leading-[1.05]"
      >
        {titleWords.map((word) => (
          <span class="block overflow-hidden py-1">
            <span class="contact-title-line block will-change-transform">
              {word}
            </span>
          </span>
        ))}
      </h1>

      <div class="flex flex-col gap-2 md:text-xl">
        <p class="contact-subcopy will-change-transform">
          Have a project in mind, need a security audit, or just want to talk
          shop?
        </p>
        <div class="contact-availability flex items-center gap-3 will-change-transform">
          <!-- Pulsing Dot Container -->
          <span class="relative flex w-3 h-3">
            <span class="inline-flex absolute bg-white opacity-75 rounded-full w-full h-full animate-ping"></span>
            <span class="inline-flex relative bg-white rounded-full w-3 h-3"></span>
          </span>
          <p class="text-sm md:text-lg">Available for new projects.</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact Details & Socials mobile/tablet -->
    <div class="flex flex-col px-8 gap-8 md:flex-row md:justify-between lg:hidden">
      <div class="flex flex-col gap-3 md:items-start lg:items-start md:gap-8">
        <p class="contact-col-item text-lg font-black md:text-3xl">[ CONTACT DIRECT ]</p>
        <a
          class="contact-col-item text-xl md:text-2xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          href="mailto:contact@jerrylott.com"
        >
          CONTACT@JERRYLOTT.COM
        </a>
        <a
          class="contact-col-item text-sm md:text-xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          href="tel:+16017785060"
        >
          +1 601 778 5060
        </a>
      </div>

      <div class="flex flex-col gap-3 md:items-start lg:items-start md:gap-8">
        <p class="contact-col-item text-lg font-black md:text-3xl">[ INDEXED SOCIAL ]</p>
        <div class="flex gap-10 md:flex-col md:gap-8">
          <a
            href="https://github.com/lottjerry"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-col-item text-sm md:text-xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          >
            Github
          </a>

          <a
            href="https://www.linkedin.com/in/jerrylott"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-col-item text-sm md:text-xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact Details & Socials desktop -->
    <div class="px-8 gap-8 hidden lg:flex lg:flex-col">
      <div class="flex flex-col gap-3 md:items-start lg:items-start md:gap-8">
        <p class="contact-col-item text-lg font-black md:text-3xl">[ CONTACT DIRECT ]</p>
        <a
          class="contact-col-item text-sm md:text-3xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          href="mailto:contact@jerrylott.com"
        >
          CONTACT@JERRYLOTT.COM
        </a>
        <a
          class="contact-col-item text-sm md:text-2xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          href="tel:+16017785060"
        >
          +1 601 778 5060
        </a>
      </div>

      <div class="flex flex-col gap-3 md:items-start lg:items-start md:gap-8">
        <p class="contact-col-item text-lg font-black md:text-3xl">[ INDEXED SOCIAL ]</p>
        <div class="flex gap-10 md:flex-col md:gap-8">
          <a
            href="https://github.com/lottjerry"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-col-item text-sm md:text-2xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          >
            Github
          </a>

          <a
            href="https://www.linkedin.com/in/jerrylott"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-col-item text-sm md:text-2xl relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let contactTimeline: gsap.core.Timeline | null = null;

  function initContactAnimations() {
    const contactSection = document.getElementById("contact");
    if (!contactSection) return;

    contactTimeline?.scrollTrigger?.kill();
    contactTimeline?.kill();

    const headerLine = document.getElementById("contact-header-line");
    const headerItems = gsap.utils.toArray<HTMLElement>("#contact .contact-header-item");
    const titleLines = gsap.utils.toArray<HTMLElement>("#contact .contact-title-line");
    const subcopy = contactSection.querySelector<HTMLElement>(".contact-subcopy");
    const availability = contactSection.querySelector<HTMLElement>(".contact-availability");
    const colItems = gsap.utils.toArray<HTMLElement>("#contact .contact-col-item");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set([headerLine, headerItems, titleLines, subcopy, availability, colItems], {
        clearProps: "all",
      });
      return;
    }

    gsap.set(headerLine, { scaleX: 0 });
    gsap.set(headerItems, { y: 10, opacity: 0 });
    gsap.set(titleLines, { yPercent: 115, opacity: 0 });
    if (subcopy) gsap.set(subcopy, { y: 20, opacity: 0 });
    if (availability) gsap.set(availability, { y: 16, opacity: 0 });
    gsap.set(colItems, { y: 22, opacity: 0 });

    contactTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: contactSection,
        start: "top 72%",
        once: true,
      },
    });

    contactTimeline
      .to(headerLine, {
        scaleX: 1,
        duration: 0.85,
        ease: "power3.inOut",
      })
      .to(
        headerItems,
        {
          y: 0,
          opacity: 1,
          duration: 0.45,
          ease: "power3.out",
          stagger: 0.08,
        },
        "<0.15"
      )
      .to(
        titleLines,
        {
          yPercent: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power4.out",
          stagger: 0.12,
          clearProps: "transform",
        },
        "-=0.45"
      );

    if (subcopy) {
      contactTimeline.to(
        subcopy,
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          ease: "power3.out",
          clearProps: "transform",
        },
        "-=0.45"
      );
    }

    if (availability) {
      contactTimeline.to(
        availability,
        {
          y: 0,
          opacity: 1,
          duration: 0.55,
          ease: "power3.out",
          clearProps: "transform",
        },
        "-=0.4"
      );
    }

    contactTimeline.to(
      colItems,
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: "power3.out",
        stagger: 0.07,
        clearProps: "transform",
      },
      "-=0.65"
    );
  }

  if (document.readyState === "complete") {
    initContactAnimations();
  } else {
    window.addEventListener("load", initContactAnimations, { once: true });
  }
  document.addEventListener("astro:page-load", initContactAnimations);
</script>