---
import projects from "@/data/projects.json";
import ProjectCard from "@/components/ProjectCard.astro";
---

<div
  id="work-section"
  class="min-h-dvh bg-black text-white flex flex-col justify-between py-6 px-4 md:py-10 md:px-12"
>
  <!-- Header -->
  <header class="w-full">
    <div class="flex gap-5 pb-4 md:pb-5 border-b border-white font-mono font-bold text-xs">
      <p>[ 02 ]</p>
      <p>/work</p>
    </div>
  </header>

  <!-- Main Gallery Wrapper -->
  <div class="w-full max-w-md md:max-w-2xl lg:max-w-none lg:w-[88%] mx-auto flex flex-col justify-center items-center gap-5 md:gap-8 my-auto py-4">
    <!-- 01 - 08 Horizontal Gallery Navigation -->
    <nav
      aria-label="Project selector"
      class="flex w-full md:max-w-md lg:justify-between lg:max-w-lg lg:text-2xl justify-between font-mono text-sm border-b border-white/20 pb-2"
    >
      {projects.map((project, index) => (
        <button
          type="button"
          data-project-nav={project.id}
          aria-current={index === 0 ? "true" : "false"}
          class:list={[
            "cursor-pointer px-1 transition-all duration-200",
            index === 0
              ? "font-bold opacity-100 underline underline-offset-8"
              : "opacity-40 hover:opacity-100",
          ]}
        >
          {project.id}
        </button>
      ))}
    </nav>

    <!-- Horizontal Project Gallery Track -->
    <div
      data-project-gallery
      class="w-full flex gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar"
    >
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const workContainer = document.getElementById("work-section");

  if (workContainer) {
    const galleryTrack = workContainer.querySelector<HTMLElement>(
      "[data-project-gallery]",
    );
    const navButtons =
      workContainer.querySelectorAll<HTMLButtonElement>("[data-project-nav]");
    const projectCards = workContainer.querySelectorAll<HTMLElement>(
      "[data-project-card]",
    );

    function setActiveProject(projectId: string | undefined) {
      if (!projectId) return;

      navButtons.forEach((btn) => {
        const isSelected = btn.dataset.projectNav === projectId;
        btn.setAttribute("aria-current", String(isSelected));
        btn.classList.toggle("font-bold", isSelected);
        btn.classList.toggle("opacity-100", isSelected);
        btn.classList.toggle("underline", isSelected);
        btn.classList.toggle("underline-offset-8", isSelected);
        btn.classList.toggle("opacity-40", !isSelected);
      });
    }

    navButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.projectNav;
        const targetCard = workContainer.querySelector<HTMLElement>(
          `[data-project-card="${targetId}"]`,
        );

        if (galleryTrack && targetCard) {
          galleryTrack.scrollTo({
            left: targetCard.offsetLeft - galleryTrack.offsetLeft,
            behavior: "smooth",
          });
        }
        setActiveProject(targetId);
      });
    });

    if (galleryTrack) {
      const galleryObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetId = (entry.target as HTMLElement).dataset
                .projectCard;
              setActiveProject(targetId);
            }
          });
        },
        {
          root: galleryTrack,
          threshold: 0.6,
        },
      );

      projectCards.forEach((card) => galleryObserver.observe(card));
    }

    projectCards.forEach((card) => {
      const buttons =
        card.querySelectorAll<HTMLButtonElement>("[data-work-target]");
      const panels = card.querySelectorAll<HTMLElement>("[data-work-panel]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetId = button.dataset.workTarget;
          if (!targetId) return;

          buttons.forEach((btn) => {
            const isSelected = btn.dataset.workTarget === targetId;
            btn.setAttribute("aria-selected", String(isSelected));
            btn.classList.toggle("font-bold", isSelected);
            btn.classList.toggle("opacity-100", isSelected);
            btn.classList.toggle("opacity-50", !isSelected);
          });

          panels.forEach((panel) => {
            const isSelected = panel.dataset.workPanel === targetId;
            panel.setAttribute("aria-hidden", String(!isSelected));
            panel.classList.toggle("opacity-100", isSelected);
            panel.classList.toggle("visible", isSelected);
            panel.classList.toggle("opacity-0", !isSelected);
            panel.classList.toggle("invisible", !isSelected);
            panel.classList.toggle("pointer-events-none", !isSelected);
          });
        });
      });
    });
  }
</script>
