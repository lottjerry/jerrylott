---
// src/sections/About.astro
import { getImage } from "astro:assets";
import desktopSrc from "@/assets/about_desktop_img.png";
import tabletSrc from "@/assets/about_tablet_img.png";
import mobileSrc from "@/assets/about_mobile_img.png";

const desktopImg = await getImage({ src: desktopSrc, format: "webp", quality: 85 });
const tabletImg = await getImage({ src: tabletSrc, format: "webp", quality: 85 });
const mobileImg = await getImage({ src: mobileSrc, format: "webp", quality: 85 });

const headline =
  "Built like an engineer, designed like an artist, stress-tested like an attacker.";
const words = headline.split(" ");
---

<div class="min-h-dvh bg-white text-black flex flex-col justify-between" id="about">
  <header class="pt-10 px-6 md:px-10 w-full">
    <div
      id="about-header-row"
      class="relative flex gap-5 pb-5 font-sans font-bold text-black"
    >
      <p class="about-header-item">[ 01 ]</p>
      <p class="about-header-item">/about</p>
      <span
        id="about-header-line"
        class="absolute bottom-0 left-0 right-0 h-px bg-black origin-left"
      ></span>
    </div>
  </header>

  <div class="flex flex-col justify-center items-center lg:flex-row lg:px-20 py-8 lg:py-5 lg:gap-8 my-auto">
    <!-- Left Column: Portrait + Role Tags -->
    <div class="flex flex-col justify-center items-center gap-5 px-6 md:px-0">
      <div
        id="about-media-mask"
        class="overflow-hidden rounded-xl will-change-transform"
      >
        <picture>
          <source
            media="(min-width: 1024px)"
            srcset={desktopImg.src}
            type="image/webp"
          />
          <source
            media="(min-width: 768px)"
            srcset={tabletImg.src}
            type="image/webp"
          />
          <img
            id="about-portrait"
            src={mobileImg.src}
            alt="Jerry Lott portrait"
            width={mobileImg.attributes.width}
            height={mobileImg.attributes.height}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover rounded-xl will-change-transform"
          />
        </picture>
      </div>

      <div class="flex flex-col justify-center items-center font-mono gap-2 md:flex-row md:gap-5">
        <p class="about-role opacity-60 lg:whitespace-nowrap">FULL-STACK DEVELOPER</p>
        <p class="about-role opacity-60 lg:whitespace-nowrap">UI/UX DESIGNER</p>
        <p class="about-role opacity-60 lg:whitespace-nowrap">SECURITY RESEARCHER</p>
      </div>
    </div>

    <!-- Right Column: Headline -> Bio -> Stats -> Resume -->
    <div class="flex flex-col justify-center items-center p-6 md:p-10 gap-8 md:gap-10 md:w-[90%] lg:w-1/2 lg:gap-24 lg:items-start">
      <h1
        id="about-headline"
        aria-label={headline}
        class="text-span font-black text-2xl sm:text-3xl lg:w-4/5 leading-tight"
      >
        {words.map((word, wordIdx) => (
          <>
            <span class="inline-block whitespace-nowrap">
              {Array.from(word).map((char) => (
                <span class="inline-block overflow-hidden align-bottom pb-[0.06em] mb-[-0.06em]">
                  <span class="about-char inline-block will-change-transform">
                    {char}
                  </span>
                </span>
              ))}
            </span>
            {wordIdx < words.length - 1 && " "}
          </>
        ))}
      </h1>

      <p id="about-bio" class="text-sm md:text-lg lg:w-4/5 will-change-transform">
        It may not be obvious, but Jerry's journey started with Full-Stack
        development. Interested in the design side of a website, he quickly
        branched out into Graphic and UI/UX design, eventually integrating a
        crucial layer of security research. This unique intersection allows him
        to manage the full project lifecycle, from visual concept to secure
        deployment, eliminating technical gaps and ensuring data safety.
      </p>

      <div
        id="about-stats"
        class="grid grid-cols-2 md:flex md:justify-between md:w-full gap-6 w-full"
      >
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="4"
            data-suffix="+"
          >
            04+
          </h2>
          <p class="text-sm font-mono lg:text-base">YEARS EXPERIENCE</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="5"
            data-suffix="+"
          >
            05+
          </h2>
          <p class="text-sm lg:text-base font-mono">COMPLETED PROJECTS</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="6"
            data-suffix="+"
          >
            06+
          </h2>
          <p class="text-sm lg:text-base font-mono">YEARS OF COLLEGE</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="2"
            data-suffix="+"
          >
            02+
          </h2>
          <p class="text-sm lg:text-base font-mono">DEGREES & MINORS</p>
        </div>
      </div>

      <a
        id="about-resume-btn"
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="font-black cursor-pointer hover:opacity-50 transition-opacity duration-500 will-change-transform"
      >
        [ RESUME ]
      </a>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let aboutMatchMedia: gsap.MatchMedia | null = null;

  function initAboutAnimations() {
    const aboutSection = document.getElementById("about");
    if (!aboutSection) return;

    aboutMatchMedia?.revert();

    const chars = gsap.utils.toArray<HTMLElement>("#about .about-char");
    const headerItems = gsap.utils.toArray<HTMLElement>("#about .about-header-item");
    const headerLine = document.getElementById("about-header-line");
    const bio = document.getElementById("about-bio");
    const mediaMask = document.getElementById("about-media-mask");
    const portrait = document.getElementById("about-portrait");
    const roles = gsap.utils.toArray<HTMLElement>("#about .about-role");
    const statItems = gsap.utils.toArray<HTMLElement>("#about .about-stat-item");
    const counters = gsap.utils.toArray<HTMLElement>("#about .about-counter");
    const resumeBtn = document.getElementById("about-resume-btn");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set(
        [chars, headerItems, headerLine, bio, mediaMask, portrait, roles, statItems, resumeBtn],
        { clearProps: "all" }
      );
      return;
    }

    function buildAboutTimeline(isDesktop: boolean) {
      gsap.set(headerLine, { scaleX: 0 });
      gsap.set(headerItems, { y: 12, opacity: 0 });
      gsap.set(chars, { yPercent: 115, opacity: 0 });
      gsap.set(mediaMask, { clipPath: "inset(100% 0% 0% 0% round 0.75rem)" });
      gsap.set(portrait, { scale: 1.1 });
      gsap.set(roles, { y: 14, opacity: 0 });
      gsap.set(bio, { y: 28, opacity: 0 });
      gsap.set(statItems, { y: 22, opacity: 0 });
      gsap.set(resumeBtn, { y: 16, opacity: 0 });

      const counterState = counters.map((el) => ({
        el,
        target: Number(el.dataset.target || 0),
        suffix: el.dataset.suffix || "",
        val: 0,
      }));

      counterState.forEach((c) => {
        c.el.textContent = `00${c.suffix}`;
      });

      const tl = gsap.timeline({
        scrollTrigger: isDesktop
          ? {
              trigger: aboutSection,
              start: "top top",
              end: "+=120%",
              pin: true,
              pinSpacing: true,
              scrub: 0.85,
              invalidateOnRefresh: true,
            }
          : {
              trigger: aboutSection,
              start: "top 85%",
              end: "bottom 85%",
              scrub: 0.75,
              invalidateOnRefresh: true,
            },
      });

      tl.to(headerLine, { scaleX: 1, duration: 0.25, ease: "none" }, 0)
        .to(headerItems, { y: 0, opacity: 1, duration: 0.2, stagger: 0.04, ease: "none" }, 0.03)
        .to(
          chars,
          {
            yPercent: 0,
            opacity: 1,
            duration: 0.4,
            stagger: 0.007,
            ease: "power2.out",
          },
          0.03
        )
        .to(
          mediaMask,
          {
            clipPath: "inset(0% 0% 0% 0% round 0.75rem)",
            duration: 0.45,
            ease: "power2.inOut",
          },
          0.12
        )
        .to(
          portrait,
          {
            scale: 1,
            duration: 0.55,
            ease: "power2.out",
          },
          0.12
        )
        .to(
          roles,
          {
            y: 0,
            opacity: 0.6,
            duration: 0.25,
            stagger: 0.05,
            ease: "none",
          },
          0.35
        )
        .to(
          bio,
          {
            y: 0,
            opacity: 1,
            duration: 0.35,
            ease: "power2.out",
          },
          0.35
        )
        .to(
          statItems,
          {
            y: 0,
            opacity: 1,
            duration: 0.3,
            stagger: 0.05,
            ease: "power2.out",
          },
          0.55
        );

      counterState.forEach((c, idx) => {
        tl.to(
          c,
          {
            val: c.target,
            duration: 0.35,
            ease: "none",
            onUpdate: () => {
              c.el.textContent = `${String(Math.round(c.val)).padStart(2, "0")}${c.suffix}`;
            },
          },
          0.55 + idx * 0.03
        );
      });

      tl.to(
        resumeBtn,
        {
          y: 0,
          opacity: 1,
          duration: 0.25,
          ease: "power2.out",
        },
        0.78
      );

      if (isDesktop) {
        tl.to({}, { duration: 0.12 });
      }
    }

    aboutMatchMedia = gsap.matchMedia();

    aboutMatchMedia.add("(min-width: 1024px)", () => {
      buildAboutTimeline(true);
    });

    aboutMatchMedia.add("(max-width: 1023px)", () => {
      buildAboutTimeline(false);
    });

    ScrollTrigger.sort();
    ScrollTrigger.refresh();
  }

  function scheduleAboutInit() {
    requestAnimationFrame(() => requestAnimationFrame(initAboutAnimations));
  }

  if (document.readyState === "complete") {
    scheduleAboutInit();
  } else {
    window.addEventListener("load", scheduleAboutInit, { once: true });
  }
  document.addEventListener("astro:page-load", scheduleAboutInit);
</script>