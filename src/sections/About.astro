---
// src/sections/About.astro
const headline =
  "Built like an engineer, designed like an artist, stress-tested like an attacker.";
const words = headline.split(" ");
---

<div class="bg-white text-black" id="about">
  <header class="pt-10 px-10 w-full">
    <div
      id="about-header-row"
      class="relative flex gap-5 pb-5 font-sans font-bold text-black"
    >
      <p class="about-header-item">[ 01 ]</p>
      <p class="about-header-item">/about</p>
      <!-- Animated bottom border line -->
      <span
        id="about-header-line"
        class="absolute bottom-0 left-0 right-0 h-px bg-black origin-left"
      ></span>
    </div>
  </header>

  <div class="flex flex-col justify-center items-center lg:flex-row lg:px-20 py-5 lg:gap-8">
    <!-- Left Column: Portrait + Role Tags -->
    <div class="flex flex-col justify-center items-center gap-5">
      <div
        id="about-media-mask"
        class="overflow-hidden rounded-xl will-change-transform"
      >
        <picture>
          <!-- Desktop view (screens 1024px and up) -->
          <source
            media="(min-width: 1024px)"
            srcset="src/assets/about_desktop_img.png"
          />

          <!-- Tablet view (screens 768px and up) -->
          <source
            media="(min-width: 768px)"
            srcset="src/assets/about_tablet_img.png"
          />

          <!-- Mobile view / Default fallback -->
          <img
            id="about-portrait"
            src="src/assets/about_mobile_img.png"
            alt="Jerry Lott portrait"
            class="w-full h-auto object-cover rounded-xl will-change-transform"
          />
        </picture>
      </div>

      <div class="flex flex-col justify-center items-center font-mono gap-2 md:flex-row md:gap-5">
        <p class="about-role opacity-60 lg:whitespace-nowrap">FULL-STACK DEVELOPER</p>
        <p class="about-role opacity-60 lg:whitespace-nowrap">UI/UX DESIGNER</p>
        <p class="about-role opacity-60 lg:whitespace-nowrap">SECURITY RESEARCHER</p>
      </div>
    </div>

    <!-- Right Column: Headline (First) -> Bio -> Stats -> Resume -->
    <div class="flex flex-col justify-center items-center p-10 gap-10 md:w-[90%] lg:w-1/2 lg:gap-24 lg:items-start">
      <!-- Word-wrapped letter spans prevent mid-word wrapping while animating char-by-char -->
      <h1
        id="about-headline"
        aria-label={headline}
        class="text-span font-black text-3xl lg:w-4/5 leading-tight"
      >
        {words.map((word, wordIdx) => (
          <>
            <span class="inline-block whitespace-nowrap">
              {Array.from(word).map((char) => (
                <span class="inline-block overflow-hidden align-bottom pb-[0.06em] mb-[-0.06em]">
                  <span class="about-char inline-block will-change-transform">
                    {char}
                  </span>
                </span>
              ))}
            </span>
            {wordIdx < words.length - 1 && " "}
          </>
        ))}
      </h1>

      <p id="about-bio" class="text-sm md:text-lg lg:w-4/5 will-change-transform">
        It may not be obvious, but Jerry's journey started with Full-Stack
        development. Interested in the design side of a website, he quickly
        branched out into Graphic and UI/UX design, eventually integrating a
        crucial layer of security research. This unique intersection allows him
        to manage the full project lifecycle, from visual concept to secure
        deployment, eliminating technical gaps and ensuring data safety.
      </p>

      <div
        id="about-stats"
        class="grid grid-cols-2 md:flex md:justify-between md:w-full gap-6"
      >
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="4"
            data-suffix="+"
          >
            04+
          </h2>
          <p class="text-sm font-mono lg:text-base">YEARS EXPERIENCE</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="5"
            data-suffix="+"
          >
            05+
          </h2>
          <p class="text-sm lg:text-base font-mono">COMPLETED PROJECTS</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="6"
            data-suffix="+"
          >
            06+
          </h2>
          <p class="text-sm lg:text-base font-mono">YEARS OF COLLEGE</p>
        </div>
        <div class="about-stat-item flex flex-col">
          <h2
            class="about-counter font-sans font-black text-2xl lg:text-4xl tabular-nums"
            data-target="2"
            data-suffix="+"
          >
            02+
          </h2>
          <p class="text-sm lg:text-base font-mono">DEGREES & MINORS</p>
        </div>
      </div>

      <button
        id="about-resume-btn"
        class="font-black cursor-pointer hover:opacity-50 transition-opacity duration-500 will-change-transform"
      >
        [ RESUME ]
      </button>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let aboutTimeline: gsap.core.Timeline | null = null;

  function initAboutAnimations() {
    const aboutSection = document.getElementById("about");
    if (!aboutSection) return;

    // Kill previous timeline on Astro View Transitions
    aboutTimeline?.scrollTrigger?.kill();
    aboutTimeline?.kill();

    const chars = gsap.utils.toArray<HTMLElement>("#about .about-char");
    const headerItems = gsap.utils.toArray<HTMLElement>("#about .about-header-item");
    const headerLine = document.getElementById("about-header-line");
    const bio = document.getElementById("about-bio");
    const mediaMask = document.getElementById("about-media-mask");
    const portrait = document.getElementById("about-portrait");
    const roles = gsap.utils.toArray<HTMLElement>("#about .about-role");
    const statItems = gsap.utils.toArray<HTMLElement>("#about .about-stat-item");
    const counters = gsap.utils.toArray<HTMLElement>("#about .about-counter");
    const resumeBtn = document.getElementById("about-resume-btn");

    // Respect reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set(
        [chars, headerItems, headerLine, bio, mediaMask, portrait, roles, statItems, resumeBtn],
        { clearProps: "all" }
      );
      return;
    }

    // 1. Set initial hidden states
    gsap.set(chars, { yPercent: 115, opacity: 0 });
    gsap.set(headerItems, { y: 10, opacity: 0 });
    gsap.set(headerLine, { scaleX: 0 });
    gsap.set(bio, { y: 24, opacity: 0 });
    gsap.set(mediaMask, { clipPath: "inset(100% 0% 0% 0% round 0.75rem)" });
    gsap.set(portrait, { scale: 1.08 });
    gsap.set(roles, { y: 12, opacity: 0 });
    gsap.set(statItems, { y: 18, opacity: 0 });
    gsap.set(resumeBtn, { y: 14, opacity: 0 });

    // Initialize counters at 00+
    counters.forEach((el) => {
      const suffix = el.dataset.suffix || "";
      el.textContent = `00${suffix}`;
    });

    // 2. Choreographed ScrollTrigger timeline (plays once when #about card rises into view)
    aboutTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: aboutSection,
        start: "top 72%",
        once: true,
      },
    });

    // STEP 1 (FIRST): Letter-by-letter headline reveal
    aboutTimeline.to(chars, {
      yPercent: 0,
      opacity: 1,
      duration: 0.55,
      ease: "power4.out",
      stagger: 0.016,
    });

    // STEP 2: [ 01 ] /about header & bottom divider draw
    aboutTimeline
      .to(
        headerLine,
        {
          scaleX: 1,
          duration: 0.7,
          ease: "power3.inOut",
        },
        "-=0.9"
      )
      .to(
        headerItems,
        {
          y: 0,
          opacity: 1,
          duration: 0.45,
          ease: "power3.out",
          stagger: 0.08,
        },
        "<0.15"
      );

    // STEP 3: Portrait clip-path curtain wipe + subtle zoom settle
    aboutTimeline
      .to(
        mediaMask,
        {
          clipPath: "inset(0% 0% 0% 0% round 0.75rem)",
          duration: 0.95,
          ease: "power4.inOut",
        },
        "-=0.45"
      )
      .to(
        portrait,
        {
          scale: 1,
          duration: 1.15,
          ease: "power3.out",
        },
        "<"
      )
      .to(
        roles,
        {
          y: 0,
          opacity: 0.6,
          duration: 0.45,
          ease: "power3.out",
          stagger: 0.08,
        },
        "-=0.5"
      );

    // STEP 4: Bio paragraph slides in cleanly
    aboutTimeline.to(
      bio,
      {
        y: 0,
        opacity: 1,
        duration: 0.65,
        ease: "power3.out",
      },
      "-=0.85"
    );

    // STEP 5: Stats stagger in + slow count up (00+ -> 04+, 05+, 06+, 02+)
    aboutTimeline.to(
      statItems,
      {
        y: 0,
        opacity: 1,
        duration: 0.55,
        ease: "power3.out",
        stagger: 0.1,
        onStart: () => {
          counters.forEach((el, index) => {
            const target = Number(el.dataset.target || 0);
            const suffix = el.dataset.suffix || "";
            const proxy = { val: 0 };

            gsap.to(proxy, {
              val: target,
              duration: 2.2,
              delay: index * 0.1,
              ease: "power1.out",
              onUpdate: () => {
                const rounded = Math.round(proxy.val);
                el.textContent = `${String(rounded).padStart(2, "0")}${suffix}`;
              },
            });
          });
        },
      },
      "-=0.45"
    );

    // STEP 6: [ RESUME ] button settles in last
    aboutTimeline.to(
      resumeBtn,
      {
        y: 0,
        opacity: 1,
        duration: 0.45,
        ease: "power3.out",
      },
      "-=0.35"
    );
  }

  // Run after window load / Layout's initScroll() so ScrollTrigger.getAll().kill() doesn't clear it
  if (document.readyState === "complete") {
    initAboutAnimations();
  } else {
    window.addEventListener("load", initAboutAnimations, { once: true });
  }
  document.addEventListener("astro:page-load", initAboutAnimations);
</script>