---
// src/components/Hero.astro
import heroBg from "../assets/hero.png";
import jerrylottSvg from "../assets/jerrylott.svg";
---

<div
  id="hero-section"
  class="relative flex justify-start items-center bg-black mt-26 lg:ml-100  md:px-16 h-dvh md:min-h-250 overflow-hidden md:pl-6 lg:pl-32"
>
  <!-- Background Image -->
  <img
    id="hero-bg"
    src={heroBg.src}
    alt="Hero Image"
    class="z-0 absolute inset-0 will-change-transform"
  />

  <!-- Dark Overlay -->
  <div id="hero-overlay" class="z-0 absolute inset-0 bg-black/40"></div>

  <!-- Hero Content (Vertically centered, left-aligned) -->
  <div class="z-10 overflow-hidden">
    <img
      id="hero-logo-svg"
      src={jerrylottSvg.src}
      alt="Jerry Lott"
      class="will-change-transform"
    />
  </div>
</div>

<script>
  import { gsap } from "gsap";

  // Quick speed adjuster: 1 = normal, 0.8 = 20% slower, 0.6 = 40% slower, 1.2 = 20% faster
  const HERO_SPEED = 0.8;

  function initHeroEntrance() {
    const hero = document.getElementById("hero-section");
    const bg = document.getElementById("hero-bg");
    const overlay = document.getElementById("hero-overlay");
    const logoSvg = document.getElementById("hero-logo-svg");

    if (!hero || !bg || !logoSvg || hero.dataset.bound) return;
    hero.dataset.bound = "true";

    // 1. Lock initial hidden states immediately so nothing flashes before preloader lifts
    gsap.set(bg, { scale: 1.12, opacity: 0 });
    gsap.set(overlay, { opacity: 0 });
    gsap.set(logoSvg, { yPercent: 105, opacity: 0 });

    const playEntrance = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        gsap.set([bg, overlay, logoSvg], { clearProps: "all" });
        return;
      }

      const tl = gsap.timeline().timeScale(HERO_SPEED);

      // Background image settles slowly from 1.12x scale to 1.0x
      tl.to(bg, {
        scale: 1,
        opacity: 1,
        duration: 1.75,
        ease: "power3.out",
      })
        .to(
          overlay,
          {
            opacity: 1,
            duration: 1.3,
            ease: "power2.out",
          },
          "<"
        )
        // jerrylott.svg rises smoothly into place
        .to(
          logoSvg,
          {
            yPercent: 0,
            opacity: 1,
            duration: 1.3,
            ease: "power4.out",
          },
          "-=1.25"
        );
    };

    // 2. Sync with Preloader.astro's reveal event (or play immediately on View Transitions)
    if (window.preloaderRevealed) {
      playEntrance();
    } else {
      window.addEventListener("preloader:reveal", playEntrance, { once: true });
    }
  }

  initHeroEntrance();
  document.addEventListener("astro:page-load", initHeroEntrance);
</script>