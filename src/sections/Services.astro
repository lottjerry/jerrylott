---
import DotGrid from "@/components/DotGrid.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import pencilIcon from "@/assets/pencil.svg";
import codeIcon from "@/assets/code.svg";
import uploadIcon from "@/assets/upload.svg";
import shieldIcon from "@/assets/shield.svg";

const services = [
  {
    id: "design",
    tabLabel: "DESIGN",
    cardLabel: "DESIGN",
    headline: "Beautiful Design.",
    icon: pencilIcon,
    iconAlt: "Pencil",
    title: "[ I ]",
    description:
      "Logos, branding, and intuitive layouts—crafted to make your business look sharp, credible, and ready to welcome customers.",
    tagline:
      "Crafting memorable brands and intuitive layouts that make your business instantly credible.",
  },
  {
    id: "development",
    label: "DEVELOPMENT",
    tabLabel: "DEVELOPMENT",
    cardLabel: "Develop",
    headline: "Robust Code.",
    icon: codeIcon,
    iconAlt: "Code",
    title: "[ II ]",
    description:
      "Whether using custom code, low-code frameworks, or no-code tools, I build the perfect fit to bring your unique vision to life cleanly and efficiently.",
    tagline:
      "Building fast, flexible websites tailored to your vision with clean, reliable code.",
  },
  {
    id: "deploy",
    tabLabel: "DEPLOY",
    cardLabel: "Deploy",
    headline: "Smooth Deployment.",
    icon: uploadIcon,
    iconAlt: "Upload",
    title: "[ III ]",
    description:
      "From setting up fast hosting to configuring domain names, your project is moved from staging to live production smoothly so you can launch with absolute confidence.",
    tagline:
      "Launching your web and software to live production smoothly, securely, and with zero hassle.",
  },
  {
    id: "defend",
    tabLabel: "DEFEND",
    cardLabel: "Defend",
    headline: "Zero Vulnerabilities.",
    icon: shieldIcon,
    iconAlt: "Shield",
    title: "[ IV ]",
    description:
      "Keeping your digital assets safe with robust security measures, regular maintenance, and constant monitoring—ensuring your platform stays protected and always online.",
    tagline:
      "Securing your web and software with rigorous testing and best practices to eliminate vulnerabilities.",
  },
];
---

<div
  id="services-section"
  class="min-h-[90vh] bg-white text-black flex flex-col gap-8 justify-between py-8 px-6 md:px-12"
>
  <!-- Header -->
  <header class="w-full">
    <div class="flex gap-5 pb-5 border-b border-black font-bold text-xs font-mono">
      <p>[ 03 ]</p>
      <p>/services</p>
    </div>
  </header>

  <!-- Title -->
  <div class="flex flex-col items-center md:items-start md:w-[82%] md:mx-auto gap-4">
    <h1 class="font-sans text-2xl md:text-3xl font-bold leading-snug max-w-xl">
      {services.map((service, index) => (
        <span
          data-tab-headline={service.id}
          class:list={[
            "cursor-pointer transition-opacity duration-200 hover:opacity-100",
            index === 0 ? "opacity-100" : "opacity-40",
          ]}
        >
          {service.headline}{" "}
        </span>
      ))}
    </h1>
    <div class="overflow-hidden max-w-full">
      <DotGrid rows={4} cols={85} gap="gap-1" />
    </div>
  </div>

  <!-- Body: Mobile Scroll-Snap | Tablet 2x2 Grid | Desktop 4-Across (1040px+) -->
  <div class="relative w-[85%] md:w-[78%] lg:w-[88%] mx-auto border-y border-black/30 md:px-6">
    <!-- Mobile-only Tab Buttons -->
    <div
      role="tablist"
      class="flex md:hidden text-xs justify-around font-mono pt-4"
    >
      {services.map((service, index) => (
        <button
          type="button"
          role="tab"
          data-tab-target={service.id}
          aria-selected={index === 0 ? "true" : "false"}
          class:list={[
            "cursor-pointer pb-1 transition-all",
            index === 0
              ? "font-bold opacity-100"
              : "opacity-50 hover:opacity-100",
          ]}
        >
          {service.tabLabel}
        </button>
      ))}
    </div>

    <!-- Track on Mobile -> 2x2 on Tablet (md:) -> 4 Across on Desktop (lg:) -->
    <div
      data-snap-track
      class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-0 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth no-scrollbar"
    >
      {services.map((service, index) => (
        <div
          role="tabpanel"
          data-tab-panel={service.id}
          class:list={[
            "w-full shrink-0 snap-center px-5 md:px-6 lg:px-5 cursor-pointer transition-all duration-200",
            "md:border md:m-[-0.5px] md:hover:opacity-100",
            index === 0
              ? "opacity-100 md:border-black md:z-10"
              : "opacity-0 md:opacity-45 md:border-black/20",
          ]}
        >
          <FeatureCard
            icon={service.icon}
            iconAlt={service.iconAlt}
            title={service.title}
            label={service.cardLabel}
            description={service.description}
            showBottomGrid={true}
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Footer -->
  <div class="w-full md:w-[85%] lg:w-[82%] mx-auto flex flex-col md:flex-row gap-6 lg:gap-12 items-center md:items-start justify-between pt-4 font-bold text-center md:text-left text-xs md:text-sm">
    <div class="overflow-hidden shrink-0 lg:shrink lg:flex-1 lg:min-w-0">
      <!-- Mobile & Tablet DotGrid -->
      <div class="lg:hidden">
        <DotGrid rows={6} cols={42} gap="gap-1" />
      </div>
      <!-- Large Screen Wider DotGrid -->
      <div class="hidden lg:block">
        <DotGrid rows={10} cols={160} gap="gap-1" />
      </div>
    </div>

    <div class="grid grid-cols-1 grid-rows-1 max-w-md shrink-0">
      {services.map((service, index) => (
        <h3
          data-tab-tagline={service.id}
          aria-hidden={index !== 0 ? "true" : "false"}
          class:list={[
            "col-start-1 row-start-1 transition-opacity duration-200 leading-snug",
            index === 0
              ? "opacity-100 visible"
              : "opacity-0 invisible pointer-events-none",
          ]}
        >
          {service.tagline}
        </h3>
      ))}
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const container = document.getElementById("services-section");

  if (container) {
    const track = container.querySelector<HTMLElement>("[data-snap-track]");
    const buttons =
      container.querySelectorAll<HTMLButtonElement>("[data-tab-target]");
    const headlines = container.querySelectorAll<HTMLElement>(
      "[data-tab-headline]",
    );
    const panels = container.querySelectorAll<HTMLElement>("[data-tab-panel]");
    const taglines =
      container.querySelectorAll<HTMLElement>("[data-tab-tagline]");

    const isTabletOrUp = () => window.matchMedia("(min-width: 768px)").matches;

    function setActiveService(targetId: string | undefined) {
      if (!targetId) return;

      buttons.forEach((btn) => {
        const isSelected = btn.dataset.tabTarget === targetId;
        btn.setAttribute("aria-selected", String(isSelected));
        btn.classList.toggle("font-bold", isSelected);
        btn.classList.toggle("opacity-100", isSelected);
        btn.classList.toggle("opacity-50", !isSelected);
      });

      headlines.forEach((headline) => {
        const isSelected = headline.dataset.tabHeadline === targetId;
        headline.classList.toggle("opacity-100", isSelected);
        headline.classList.toggle("opacity-40", !isSelected);
      });

      panels.forEach((panel) => {
        const isSelected = panel.dataset.tabPanel === targetId;
        panel.classList.toggle("opacity-100", isSelected);
        panel.classList.toggle("opacity-0", !isSelected);
        panel.classList.toggle("md:opacity-45", !isSelected);
        panel.classList.toggle("md:border-black", isSelected);
        panel.classList.toggle("md:border-black/20", !isSelected);
        panel.classList.toggle("md:z-10", isSelected);
      });

      taglines.forEach((tagline) => {
        const isSelected = tagline.dataset.tabTagline === targetId;
        tagline.setAttribute("aria-hidden", String(!isSelected));
        tagline.classList.toggle("opacity-100", isSelected);
        tagline.classList.toggle("visible", isSelected);
        tagline.classList.toggle("opacity-0", !isSelected);
        tagline.classList.toggle("invisible", !isSelected);
        tagline.classList.toggle("pointer-events-none", !isSelected);
      });
    }

    function selectAndScroll(targetId: string | undefined) {
      if (!targetId) return;
      const targetPanel = container?.querySelector<HTMLElement>(
        `[data-tab-panel="${targetId}"]`,
      );

      if (track && targetPanel && !isTabletOrUp()) {
        track.scrollTo({
          left: targetPanel.offsetLeft - track.offsetLeft,
          behavior: "smooth",
        });
      }

      setActiveService(targetId);
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () =>
        selectAndScroll(button.dataset.tabTarget),
      );
    });

    panels.forEach((panel) => {
      panel.addEventListener("click", () => {
        if (isTabletOrUp()) {
          setActiveService(panel.dataset.tabPanel);
        }
      });
    });

    headlines.forEach((headline) => {
      headline.addEventListener("click", () =>
        selectAndScroll(headline.dataset.tabHeadline),
      );
    });

    if (track) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (isTabletOrUp()) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetId = (entry.target as HTMLElement).dataset.tabPanel;
              setActiveService(targetId);
            }
          });
        },
        {
          root: track,
          threshold: 0.6,
        },
      );

      panels.forEach((panel) => observer.observe(panel));
    }
  }
</script>