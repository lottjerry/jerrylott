---
import DotGrid from "@/components/DotGrid.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import pencilIcon from "@/assets/pencil.svg";
import codeIcon from "@/assets/code.svg";
import uploadIcon from "@/assets/upload.svg";
import shieldIcon from "@/assets/shield.svg";

const services = [
  {
    id: "design",
    tabLabel: "DESIGN",
    cardLabel: "DESIGN",
    headline: "Beautiful Design.",
    icon: pencilIcon,
    iconAlt: "Pencil",
    title: "[ I ]",
    description:
      "Logos, branding, and intuitive layouts—crafted to make your business look sharp, credible, and ready to welcome customers.",
    tagline:
      "Crafting memorable brands and intuitive layouts that make your business instantly credible.",
  },
  {
    id: "development",
    label: "DEVELOPMENT",
    tabLabel: "DEVELOPMENT",
    cardLabel: "Develop",
    headline: "Robust Code.",
    icon: codeIcon,
    iconAlt: "Code",
    title: "[ II ]",
    description:
      "Whether using custom code, low-code frameworks, or no-code tools, I build the perfect fit to bring your unique vision to life cleanly and efficiently.",
    tagline:
      "Building fast, flexible websites tailored to your vision with clean, reliable code.",
  },
  {
    id: "deploy",
    tabLabel: "DEPLOY",
    cardLabel: "Deploy",
    headline: "Smooth Deployment.",
    icon: uploadIcon,
    iconAlt: "Upload",
    title: "[ III ]",
    description:
      "From setting up fast hosting to configuring domain names, your project is moved from staging to live production smoothly so you can launch with absolute confidence.",
    tagline:
      "Launching your web and software to live production smoothly, securely, and with zero hassle.",
  },
  {
    id: "defend",
    tabLabel: "DEFEND",
    cardLabel: "Defend",
    headline: "Zero Vulnerabilities.",
    icon: shieldIcon,
    iconAlt: "Shield",
    title: "[ IV ]",
    description:
      "Keeping your digital assets safe with robust security measures, regular maintenance, and constant monitoring—ensuring your platform stays protected and always online.",
    tagline:
      "Securing your web and software with rigorous testing and best practices to eliminate vulnerabilities.",
  },
];
---

<div
  id="services"
  class="min-h-dvh bg-white text-black flex flex-col gap-8 justify-between py-8 px-6 md:px-12"
>
  <!-- Header -->
  <header class="w-full">
    <div class="relative flex gap-5 pb-5 font-bold text-xs font-mono">
      <p class="services-header-item">[ 03 ]</p>
      <p class="services-header-item">/services</p>
      <span
        id="services-header-line"
        class="absolute bottom-0 left-0 right-0 h-px bg-black origin-left"
      ></span>
    </div>
  </header>

  <!-- Title -->
  <div class="flex flex-col items-center md:items-start md:w-[82%] md:mx-auto gap-4">
    <h1 class="font-sans text-2xl md:text-3xl font-bold leading-snug max-w-xl">
      {services.map((service, index) => {
        const words = service.headline.split(" ");
        return (
          <>
            <span
              data-tab-headline={service.id}
              class:list={[
                "cursor-pointer transition-opacity duration-200 hover:opacity-100",
                index === 0 ? "opacity-100" : "opacity-40",
              ]}
            >
              {words.map((word, wIdx) => (
                <>
                  <span class="inline-block overflow-hidden align-bottom pb-[0.08em] mb-[-0.08em]">
                    <span class="services-title-word inline-block will-change-transform">
                      {word}
                    </span>
                  </span>
                  {wIdx < words.length - 1 && " "}
                </>
              ))}
            </span>{" "}
          </>
        );
      })}
    </h1>
    <div id="services-top-dots" class="overflow-hidden max-w-full">
      <DotGrid rows={4} cols={85} gap="gap-1" />
    </div>
  </div>

  <!-- Body: Mobile Scroll-Snap | Tablet 2x2 Grid | Desktop 4-Across (1040px+) -->
  <div
    id="services-grid-wrap"
    class="relative w-[85%] md:w-[78%] lg:w-[88%] mx-auto md:px-6"
  >
    <span
      id="services-grid-top-line"
      class="absolute top-0 left-0 right-0 h-px bg-black/30 origin-left"
    ></span>
    <span
      id="services-grid-bottom-line"
      class="absolute bottom-0 left-0 right-0 h-px bg-black/30 origin-left"
    ></span>

    <!-- Mobile-only Tab Buttons -->
    <div
      role="tablist"
      class="flex md:hidden text-xs justify-around font-mono pt-4"
    >
      {services.map((service, index) => (
        <button
          type="button"
          role="tab"
          data-tab-target={service.id}
          aria-selected={index === 0 ? "true" : "false"}
          class:list={[
            "services-mobile-tab cursor-pointer pb-1 transition-all",
            index === 0
              ? "font-bold opacity-100"
              : "opacity-50 hover:opacity-100",
          ]}
        >
          {service.tabLabel}
        </button>
      ))}
    </div>

    <!-- Track on Mobile -> 2x2 on Tablet (md:) -> 4 Across on Desktop (lg:) -->
    <div
      data-snap-track
      class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-0 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth no-scrollbar"
    >
      {services.map((service, index) => (
        <div
          role="tabpanel"
          data-tab-panel={service.id}
          class:list={[
            "w-full shrink-0 snap-center px-5 md:px-6 lg:px-5 cursor-pointer transition-all duration-200",
            "md:border md:m-[-0.5px] md:hover:opacity-100",
            index === 0
              ? "opacity-100 md:border-black md:z-10"
              : "opacity-0 md:opacity-45 md:border-black/20",
          ]}
        >
          <div class="services-card-inner will-change-transform">
            <FeatureCard
              icon={service.icon}
              iconAlt={service.iconAlt}
              title={service.title}
              label={service.cardLabel}
              description={service.description}
              showBottomGrid={true}
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Footer -->
  <div
    id="services-footer-wrap"
    class="w-full md:w-[85%] lg:w-[82%] mx-auto flex flex-col md:flex-row gap-6 lg:gap-12 items-center md:items-start justify-between pt-4 font-bold text-center md:text-left text-xs md:text-sm"
  >
    <div
      id="services-bottom-dots"
      class="overflow-hidden shrink-0 lg:shrink lg:flex-1 lg:min-w-0"
    >
      <div class="lg:hidden">
        <DotGrid rows={6} cols={42} gap="gap-1" />
      </div>
      <div class="hidden lg:block">
        <DotGrid rows={10} cols={160} gap="gap-1" />
      </div>
    </div>

    <div
      id="services-tagline-box"
      class="grid grid-cols-1 grid-rows-1 max-w-md shrink-0 will-change-transform"
    >
      {services.map((service, index) => (
        <h3
          data-tab-tagline={service.id}
          aria-hidden={index !== 0 ? "true" : "false"}
          class:list={[
            "col-start-1 row-start-1 transition-opacity duration-200 leading-snug",
            index === 0
              ? "opacity-100 visible"
              : "opacity-0 invisible pointer-events-none",
          ]}
        >
          {service.tagline}
        </h3>
      ))}
    </div>
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let servicesMatchMedia: gsap.MatchMedia | null = null;

  function initServicesAnimations() {
    const container = document.getElementById("services");
    if (!container) return;

    servicesMatchMedia?.revert();

    const headerLine = document.getElementById("services-header-line");
    const headerItems = gsap.utils.toArray<HTMLElement>("#services .services-header-item");
    const titleWords = gsap.utils.toArray<HTMLElement>("#services .services-title-word");
    const topDots = document.getElementById("services-top-dots");
    const gridTopLine = document.getElementById("services-grid-top-line");
    const gridBottomLine = document.getElementById("services-grid-bottom-line");
    const mobileTabs = gsap.utils.toArray<HTMLElement>("#services .services-mobile-tab");
    const cardInners = gsap.utils.toArray<HTMLElement>("#services .services-card-inner");
    const bottomDots = document.getElementById("services-bottom-dots");
    const taglineBox = document.getElementById("services-tagline-box");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set(
        [
          headerLine,
          headerItems,
          titleWords,
          topDots,
          gridTopLine,
          gridBottomLine,
          mobileTabs,
          cardInners,
          bottomDots,
          taglineBox,
        ],
        { clearProps: "all" }
      );
      return;
    }

    function buildServicesTimeline(isDesktop: boolean) {
      gsap.set(headerLine, { scaleX: 0 });
      gsap.set(headerItems, { y: 12, opacity: 0 });
      gsap.set(titleWords, { yPercent: 115, opacity: 0 });
      gsap.set(topDots, { clipPath: "inset(0% 100% 0% 0%)" });
      gsap.set([gridTopLine, gridBottomLine], { scaleX: 0 });
      gsap.set(mobileTabs, { y: 12, opacity: 0 });
      gsap.set(cardInners, { y: 36, opacity: 0 });
      gsap.set(bottomDots, { clipPath: "inset(0% 100% 0% 0%)" });
      gsap.set(taglineBox, { y: 20, opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: isDesktop
          ? {
              trigger: container,
              start: "top top",
              end: "+=120%",
              pin: true,
              pinSpacing: true,
              scrub: 0.85,
              anticipatePin: 1,
              invalidateOnRefresh: true,
            }
          : {
              trigger: container,
              start: "top 85%",
              end: "bottom 85%",
              scrub: 0.75,
              invalidateOnRefresh: true,
            },
      });

      tl.to(headerLine, { scaleX: 1, duration: 0.25, ease: "none" }, 0)
        .to(headerItems, { y: 0, opacity: 1, duration: 0.2, stagger: 0.05, ease: "none" }, 0.03)
        .to(
          titleWords,
          {
            yPercent: 0,
            opacity: 1,
            duration: 0.4,
            stagger: 0.04,
            ease: "power2.out",
          },
          0.03
        )
        .to(
          topDots,
          {
            clipPath: "inset(0% 0% 0% 0%)",
            duration: 0.35,
            ease: "none",
          },
          0.2
        )
        .to(
          [gridTopLine, gridBottomLine],
          {
            scaleX: 1,
            duration: 0.35,
            stagger: 0.08,
            ease: "none",
          },
          0.25
        )
        .to(
          mobileTabs,
          {
            y: 0,
            opacity: (i) => (i === 0 ? 1 : 0.5),
            duration: 0.25,
            stagger: 0.04,
            ease: "none",
          },
          0.35
        )
        .to(
          cardInners,
          {
            y: 0,
            opacity: 1,
            duration: 0.4,
            stagger: 0.07,
            ease: "power2.out",
          },
          0.35
        )
        .to(
          bottomDots,
          {
            clipPath: "inset(0% 0% 0% 0%)",
            duration: 0.35,
            ease: "none",
          },
          0.62
        )
        .to(
          taglineBox,
          {
            y: 0,
            opacity: 1,
            duration: 0.3,
            ease: "power2.out",
          },
          0.72
        );

      if (isDesktop) {
        tl.to({}, { duration: 0.12 });
      }
    }

    servicesMatchMedia = gsap.matchMedia();

    servicesMatchMedia.add("(min-width: 1024px)", () => {
      buildServicesTimeline(true);
    });

    servicesMatchMedia.add("(max-width: 1023px)", () => {
      buildServicesTimeline(false);
    });

    ScrollTrigger.sort();
    ScrollTrigger.refresh();
  }

  function initServicesInteractions() {
    const container = document.getElementById("services");
    if (!container || container.dataset.bound === "true") return;
    container.dataset.bound = "true";

    const track = container.querySelector<HTMLElement>("[data-snap-track]");
    const buttons =
      container.querySelectorAll<HTMLButtonElement>("[data-tab-target]");
    const headlines = container.querySelectorAll<HTMLElement>(
      "[data-tab-headline]"
    );
    const panels = container.querySelectorAll<HTMLElement>("[data-tab-panel]");
    const taglines =
      container.querySelectorAll<HTMLElement>("[data-tab-tagline]");

    const isTabletOrUp = () => window.matchMedia("(min-width: 768px)").matches;

    function setActiveService(targetId: string | undefined) {
      if (!targetId) return;

      buttons.forEach((btn) => {
        const isSelected = btn.dataset.tabTarget === targetId;
        btn.setAttribute("aria-selected", String(isSelected));
        btn.classList.toggle("font-bold", isSelected);
        btn.classList.toggle("opacity-100", isSelected);
        btn.classList.toggle("opacity-50", !isSelected);
      });

      headlines.forEach((headline) => {
        const isSelected = headline.dataset.tabHeadline === targetId;
        headline.classList.toggle("opacity-100", isSelected);
        headline.classList.toggle("opacity-40", !isSelected);
      });

      panels.forEach((panel) => {
        const isSelected = panel.dataset.tabPanel === targetId;
        panel.classList.toggle("opacity-100", isSelected);
        panel.classList.toggle("opacity-0", !isSelected);
        panel.classList.toggle("md:opacity-45", !isSelected);
        panel.classList.toggle("md:border-black", isSelected);
        panel.classList.toggle("md:border-black/20", !isSelected);
        panel.classList.toggle("md:z-10", isSelected);
      });

      taglines.forEach((tagline) => {
        const isSelected = tagline.dataset.tabTagline === targetId;
        tagline.setAttribute("aria-hidden", String(!isSelected));
        tagline.classList.toggle("opacity-100", isSelected);
        tagline.classList.toggle("visible", isSelected);
        tagline.classList.toggle("opacity-0", !isSelected);
        tagline.classList.toggle("invisible", !isSelected);
        tagline.classList.toggle("pointer-events-none", !isSelected);

        if (isSelected && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          gsap.fromTo(
            tagline,
            { y: 8 },
            { y: 0, duration: 0.35, ease: "power2.out", clearProps: "transform" }
          );
        }
      });
    }

    function selectAndScroll(targetId: string | undefined) {
      if (!targetId) return;
      const targetPanel = container?.querySelector<HTMLElement>(
        `[data-tab-panel="${targetId}"]`
      );

      if (track && targetPanel && !isTabletOrUp()) {
        track.scrollTo({
          left: targetPanel.offsetLeft - track.offsetLeft,
          behavior: "smooth",
        });
      }

      setActiveService(targetId);
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () =>
        selectAndScroll(button.dataset.tabTarget)
      );
    });

    panels.forEach((panel) => {
      panel.addEventListener("click", () => {
        if (isTabletOrUp()) {
          setActiveService(panel.dataset.tabPanel);
        }
      });
    });

    headlines.forEach((headline) => {
      headline.addEventListener("click", () =>
        selectAndScroll(headline.dataset.tabHeadline)
      );
    });

    if (track) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (isTabletOrUp()) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const targetId = (entry.target as HTMLElement).dataset.tabPanel;
              setActiveService(targetId);
            }
          });
        },
        {
          root: track,
          threshold: 0.6,
        }
      );

      panels.forEach((panel) => observer.observe(panel));
    }
  }

  initServicesInteractions();

  function scheduleServicesInit() {
    requestAnimationFrame(() => requestAnimationFrame(initServicesAnimations));
  }

  if (document.readyState === "complete") {
    scheduleServicesInit();
  } else {
    window.addEventListener("load", scheduleServicesInit, { once: true });
  }

  document.addEventListener("astro:page-load", () => {
    initServicesInteractions();
    scheduleServicesInit();
  });
</script>