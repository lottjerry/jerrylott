---
// src/components/navigation/Header.astro
import HamburgerButton from "./HamburgerButton.astro";
import NavigationOverlay from "./NavigationOverlay.astro";
---

<!-- Added z-50 and relative so header stays on top of the overlay -->
<nav class="z-50 relative flex justify-between items-center p-5 md:p-10 w-dvw text-white">
  <!-- Wrapped JL in an anchor tag linked to the top -->
  <a href="#" class="hover:opacity-70 font-sans font-bold text-2xl transition-opacity">
    JL
  </a>
  
  <HamburgerButton scale={0.7} />
</nav>

<!-- Render the overlay component right here -->
<NavigationOverlay />