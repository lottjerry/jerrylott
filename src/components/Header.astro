---
// src/components/navigation/Header.astro
import HamburgerButton from "@/components/HamburgerButton.astro";
import NavigationOverlay from "@/components/NavigationOverlay.astro";
---

<nav
  id="site-header"
  class="z-50 fixed top-2 left-2 right-2 flex justify-between items-center h-16 px-5 md:px-10 text-white mix-blend-difference pointer-events-none will-change-transform"
>
  <a
    id="header-logo"
    href="#"
    class="pointer-events-auto hover:opacity-70 font-sans font-bold text-lg lg:text-2xl transition-opacity"
  >
    JL
  </a>

<div class="pointer-events-auto origin-right scale-[0.5] lg:scale-[.75]">
    <HamburgerButton scale={1} />
  </div>
</nav>

<NavigationOverlay />

<script>
  import { gsap } from "gsap";

  let headerMatchMedia: gsap.MatchMedia | null = null;

  function initHeader() {
    const header = document.getElementById("site-header");
    const logo = document.getElementById("header-logo");
    if (!header || !logo) return;

    // 1. Bind logo click-to-top once
    if (!logo.dataset.bound) {
      logo.dataset.bound = "true";

      logo.addEventListener("click", (e) => {
        e.preventDefault();

        const closeMenu = (window as unknown as { closeNavMenu?: () => void }).closeNavMenu;
        if (typeof closeMenu === "function") {
          closeMenu();
        }

        window.location.hash = "";
        history.replaceState(null, "", "#");

        setTimeout(() => {
          document.documentElement.style.overflow = "";
          document.body.style.overflow = "";

          if (window.smoothScrollLenis) {
            window.smoothScrollLenis.start();
            window.smoothScrollLenis.scrollTo(0, { immediate: false, force: true });
          }

          window.scrollTo({ top: 0, behavior: "smooth" });
        }, 10);
      });
    }

    // 2. Clean up any previous matchMedia instance before re-initializing
    headerMatchMedia?.revert();
    headerMatchMedia = gsap.matchMedia();

    // 3. Apply hide-on-scroll-down / show-on-scroll-up strictly on mobile (< 768px)
    headerMatchMedia.add(
      "(max-width: 767px) and (prefers-reduced-motion: no-preference)",
      () => {
        let isHidden = false;
        let lastScrollY = window.scrollY;
        let anchorScrollY = window.scrollY;
        const THRESHOLD = 15; // px of intentional scroll before toggling

        const showHeader = () => {
          if (!isHidden) return;
          isHidden = false;
          gsap.to(header, {
            yPercent: 0,
            opacity: 1,
            duration: 0.35,
            ease: "power3.out",
            overwrite: "auto",
          });
        };

        const hideHeader = () => {
          if (isHidden) return;
          isHidden = true;
          gsap.to(header, {
            yPercent: -130,
            opacity: 0,
            duration: 0.3,
            ease: "power3.in",
            overwrite: "auto",
          });
        };

        const onScroll = () => {
          const currentY = window.scrollY;
          const direction = currentY > lastScrollY ? 1 : currentY < lastScrollY ? -1 : 0;
          lastScrollY = currentY;

          // Keep visible if the navigation overlay is open, near top of page, or at the bottom
          const overlay = document.getElementById("navigation-overlay");
          const isMenuOpen =
            overlay?.getAttribute("aria-hidden") === "false" ||
            document.body.style.overflow === "hidden";

          const isAtBottom =
            currentY + window.innerHeight >= document.documentElement.scrollHeight - 40;

          if (isMenuOpen || currentY < 80 || isAtBottom) {
            anchorScrollY = currentY;
            showHeader();
            return;
          }

          const delta = currentY - anchorScrollY;

          // Reset anchor whenever scroll direction reverses
          if ((delta > 0 && direction === -1) || (delta < 0 && direction === 1)) {
            anchorScrollY = currentY;
            return;
          }

          if (delta > THRESHOLD) {
            hideHeader();
            anchorScrollY = currentY;
          } else if (delta < -THRESHOLD) {
            showHeader();
            anchorScrollY = currentY;
          }
        };

        window.addEventListener("scroll", onScroll, { passive: true });

        // Cleanup automatically runs when viewport resizes >= 768px
        return () => {
          window.removeEventListener("scroll", onScroll);
          gsap.set(header, { clearProps: "transform,opacity" });
        };
      }
    );
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>