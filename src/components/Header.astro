---
// src/components/navigation/Header.astro
import HamburgerButton from "@/components/HamburgerButton.astro";
import NavigationOverlay from "@/components/NavigationOverlay.astro";
---

<nav class="z-50 fixed top-2 left-2 right-2 flex justify-between items-center h-16 px-5 md:px-10 text-white bg-black/80 backdrop-blur-md rounded-4xl">
  <a
    id="header-logo"
    href="#"
    class="hover:opacity-70 font-sans font-bold text-2xl transition-opacity"
  >
    JL
  </a>

  <HamburgerButton scale={0.7} />
</nav>

<NavigationOverlay />

<script>
  function initHeaderLogo() {
    const logo = document.getElementById("header-logo");
    if (!logo || logo.dataset.bound) return;
    logo.dataset.bound = "true";

    logo.addEventListener("click", (e) => {
      e.preventDefault();

      // 1. Close overlay if open
      const closeMenu = (window as unknown as { closeNavMenu?: () => void }).closeNavMenu;
      if (typeof closeMenu === "function") {
        closeMenu();
      }

      // 2. Update URL to "#"
      window.location.hash = "";
      history.replaceState(null, "", "#");

      // 3. Force scroll to top across Lenis and native window
      setTimeout(() => {
        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";

        if (window.smoothScrollLenis) {
          window.smoothScrollLenis.start();
          window.smoothScrollLenis.scrollTo(0, { immediate: false, force: true });
        }

        window.scrollTo({ top: 0, behavior: "smooth" });
      }, 10);
    });
  }

  initHeaderLogo();
  document.addEventListener("astro:page-load", initHeaderLogo);
</script>