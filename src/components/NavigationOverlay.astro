---
// src/components/navigation/NavigationOverlay.astro
---

<!-- Fullscreen overlay container (hidden by default using opacity & pointer-events) -->
<div
  id="nav-overlay"
  class="z-40 fixed inset-0 flex flex-col justify-center items-center bg-black transition-opacity duration-300 pointer-events-none"
>
  <nav class="flex flex-col items-center gap-8 font-sans font-semibold text-white text-3xl">
    <a href="#" class="hover:text-red-500 transition-colors nav-link">
      Home
    </a>
    <a href="#about" class="hover:text-red-500 transition-colors nav-link">
      About
    </a>
    <a href="#services" class="hover:text-red-500 transition-colors nav-link">
      Services
    </a>
    <a href="#contact" class="hover:text-red-500 transition-colors nav-link">
      Contact
    </a>
  </nav>
  <footer class="bottom-0 fixed p-10 w-[90%] font-span text-white">
    <div class="flex lg:flex-row flex-col justify-between items-center gap-5 p-10 border-white/20 border-t">
      <div class="flex items-center gap-3">
        <!-- Pulsing Dot Container -->
        <span class="relative flex w-3 h-3">
          <span class="inline-flex absolute bg-white opacity-75 rounded-full w-full h-full animate-ping"></span>
          <span class="inline-flex relative bg-white rounded-full w-3 h-3"></span>
        </span>
        <p>Available for new projects.</p>
      </div>

      <div class="flex gap-5">
        <p>Resume</p>
        <p>|</p>
        <p>Github</p>
        <p>|</p>
        <p>LinkedIn</p>
      </div>
    </div>
  </footer>
</div>

<!-- Script to handle opening/closing based on the hamburger click -->
<script is:inline>
  document.addEventListener("menu-toggle", (e) => {
    const overlay = document.getElementById("nav-overlay");
    const hamburgerBtn = document.getElementById("menu-toggle");
    if (!overlay) return;

    const { isActive } = e.detail;

    if (isActive) {
      // Open Overlay
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden"; // Prevent background scrolling
    } else {
      // Close Overlay
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = ""; // Restore scrolling
    }
  });

  // Optional: Close overlay automatically when a link inside it is clicked
  document.querySelectorAll("#nav-overlay a").forEach((link) => {
    link.addEventListener("click", () => {
      const overlay = document.getElementById("nav-overlay");
      const hamburgerBtn = document.getElementById("menu-toggle");

      if (overlay) {
        overlay.classList.remove("opacity-100", "pointer-events-auto");
        overlay.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
      }
      if (hamburgerBtn) {
        hamburgerBtn.classList.remove("is-active");
        hamburgerBtn.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
