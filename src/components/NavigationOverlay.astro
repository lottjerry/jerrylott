---
// src/components/navigation/NavigationOverlay.astro
---

<!-- Fullscreen overlay container -->
<div
  id="nav-overlay"
  aria-hidden="true"
  class="z-40 fixed inset-0 flex flex-col bg-black pointer-events-none justify-center items-center pb-20"
  style="clip-path: inset(0% 0% 100% 0%);"
>
  <nav class="flex flex-col items-start gap-10 font-mono font-thin text-white text-3xl mx-auto w-fit md:w-[60%]">
    <a
      href="#"
      class="nav-link overflow-hidden flex items-start gap-6 opacity-100 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="nav-link-inner flex items-start gap-6">
        <span class="text-sm md:text-2xl w-6 text-left">01</span>
        <span class="md:text-6xl">Home</span>
      </span>
    </a>

    <a
      href="#about"
      class="nav-link overflow-hidden flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="nav-link-inner flex items-start gap-6">
        <span class="text-sm md:text-2xl w-6 text-left">02</span>
        <span class="md:text-6xl">About</span>
      </span>
    </a>

    <a
      href="#work"
      class="nav-link overflow-hidden flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="nav-link-inner flex items-start gap-6">
        <span class="text-sm md:text-2xl w-6 text-left">03</span>
        <span class="md:text-6xl">Work</span>
      </span>
    </a>

    <a
      href="#services"
      class="nav-link overflow-hidden flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="nav-link-inner flex items-start gap-6">
        <span class="text-sm md:text-2xl w-6 text-left">04</span>
        <span class="md:text-6xl">Services</span>
      </span>
    </a>

    <a
      href="#contact"
      class="nav-link overflow-hidden flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="nav-link-inner flex items-start gap-6">
        <span class="text-sm md:text-2xl w-6 text-left">05</span>
        <span class="md:text-6xl">Contact</span>
      </span>
    </a>
  </nav>

  <footer id="nav-footer" class="bottom-0 fixed p-5 md:p-10 w-[90%] font-sans text-white">
    <div class="flex lg:flex-row flex-col justify-between items-center gap-5 p-10 border-white/20 border-t">
      <div class="flex items-center gap-3">
        <!-- Pulsing Dot Container -->
        <span class="relative flex w-3 h-3">
          <span class="inline-flex absolute bg-white opacity-75 rounded-full w-full h-full animate-ping"></span>
          <span class="inline-flex relative bg-white rounded-full w-3 h-3"></span>
        </span>
        <p>Available for new projects.</p>
      </div>

      <div class="flex gap-5 text-white">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Resume
        </a>

        <p>|</p>

        <a
          href="https://github.com/lottjerry"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Github
        </a>

        <p>|</p>

        <a
          href="https://www.linkedin.com/in/jerrylott"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </footer>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  declare global {
    interface Window {
      closeNavMenu?: () => void;
      __navListenersBound?: boolean;
    }
  }

  const NAVBAR_OFFSET = -96;
  const SCROLL_DELAY = 0.35;

  let activeNavHref = "#";
  let navTimeline: gsap.core.Timeline | null = null;
  let pendingScrollCall: gsap.core.Tween | null = null;

  function setActiveNavLink(href: string) {
    activeNavHref = href;
    const links = document.querySelectorAll("#nav-overlay .nav-link");
    links.forEach((link) => {
      const isCurrent = link.getAttribute("href") === href;
      link.classList.toggle("opacity-100", isCurrent);
      link.classList.toggle("opacity-30", !isCurrent);
      if (isCurrent) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  function syncActiveSectionFromScroll() {
    if (window.scrollY < window.innerHeight * 0.4) {
      setActiveNavLink("#");
      return;
    }

    const midY = window.innerHeight * 0.5;
    const sectionIds = ["about", "work", "services", "contact"];
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top <= midY && rect.bottom >= midY) {
        setActiveNavLink(`#${id}`);
        return;
      }
    }
  }

  function syncHamburgerWithOverlay() {
    const overlay = document.getElementById("nav-overlay");
    const btn = document.getElementById("menu-toggle");
    if (!overlay || !btn) return;

    const isOpen = overlay.classList.contains("is-open");
    btn.classList.toggle("is-active", isOpen);
    btn.setAttribute("aria-expanded", String(isOpen));
  }

  function buildNavTimeline(overlay: HTMLElement) {
    const linkInners = overlay.querySelectorAll(".nav-link-inner");
    const footer = overlay.querySelector("#nav-footer");

    gsap.set(overlay, { clipPath: "inset(0% 0% 100% 0%)" });
    gsap.set(linkInners, { yPercent: 110, opacity: 0 });
    gsap.set(footer, { y: 20, opacity: 0 });

    const tl = gsap.timeline({
      paused: true,
      onStart: () => {
        overlay.classList.add("is-open", "pointer-events-auto");
        overlay.classList.remove("pointer-events-none");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        window.smoothScrollLenis?.stop();
      },
      onReverseComplete: () => {
        overlay.classList.remove("is-open", "pointer-events-auto");
        overlay.classList.add("pointer-events-none");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        window.smoothScrollLenis?.start();
      },
    });

    tl.to(overlay, {
      clipPath: "inset(0% 0% 0% 0%)",
      duration: 0.6,
      ease: "power4.inOut",
    })
      .to(
        linkInners,
        {
          yPercent: 0,
          opacity: 1,
          duration: 0.45,
          stagger: 0.06,
          ease: "power3.out",
        },
        "-=0.25"
      )
      .to(
        footer,
        {
          y: 0,
          opacity: 1,
          duration: 0.35,
          ease: "power2.out",
        },
        "-=0.25"
      );

    return tl;
  }

  function runScroll(href: string) {
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
    const target = href === "#" ? 0 : href;
    const offset = href === "#" ? 0 : NAVBAR_OFFSET;

    if (window.smoothScrollLenis) {
      window.smoothScrollLenis.start();
      window.smoothScrollLenis.scrollTo(target, { offset, force: true });
    } else if (href === "#") {
      window.scrollTo({ top: 0, behavior: "smooth" });
    } else {
      document.querySelector(href)?.scrollIntoView({ behavior: "smooth" });
    }
  }

  function consumePendingSectionScroll() {
    const pending = sessionStorage.getItem("pending_section_scroll");
    if (!pending) return;

    const executeAfterPreloaderUnlock = () => {
      const curtain = document.getElementById("preloader-curtain");
      // Wait until Preloader has completely hidden the curtain and unlocked body/Lenis
      if (curtain && curtain.style.display !== "none") {
        gsap.delayedCall(0.1, executeAfterPreloaderUnlock);
        return;
      }

      sessionStorage.removeItem("pending_section_scroll");
      ScrollTrigger.refresh();
      setActiveNavLink(pending);

      requestAnimationFrame(() => {
        runScroll(pending);
      });
    };

    executeAfterPreloaderUnlock();
  }

  function openMenu() {
    const overlay = document.getElementById("nav-overlay");
    if (!overlay || !navTimeline) return;

    pendingScrollCall?.kill();
    syncActiveSectionFromScroll();
    navTimeline.timeScale(1).play();
  }

  window.closeNavMenu = function () {
    if (!navTimeline || navTimeline.progress() === 0) return;
    navTimeline.timeScale(1.35).reverse();
  };

  function initNavigationOverlay() {
    const overlay = document.getElementById("nav-overlay");
    if (!overlay) return;

    navTimeline?.kill();
    navTimeline = buildNavTimeline(overlay);

    if (!overlay.dataset.observed) {
      overlay.dataset.observed = "true";
      const observer = new MutationObserver(syncHamburgerWithOverlay);
      observer.observe(overlay, { attributes: true, attributeFilter: ["class"] });
    }

    const sectionIds = ["about", "work", "services", "contact"];
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        if (window.scrollY < window.innerHeight * 0.4) {
          setActiveNavLink("#");
          return;
        }
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveNavLink(`#${entry.target.id}`);
          }
        });
      },
      {
        rootMargin: "-40% 0px -40% 0px",
        threshold: 0,
      }
    );

    sectionIds.forEach((id) => {
      const section = document.getElementById(id);
      if (section) sectionObserver.observe(section);
    });

    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY < window.innerHeight * 0.4 && activeNavHref !== "#") {
          setActiveNavLink("#");
        }
      },
      { passive: true }
    );

    syncActiveSectionFromScroll();
    consumePendingSectionScroll();

    if (!window.__navListenersBound) {
      window.__navListenersBound = true;

      document.addEventListener("menu-toggle", (e) => {
        const detail = (e as CustomEvent<{ isActive?: boolean }>).detail;
        if (detail?.isActive) {
          openMenu();
        } else {
          window.closeNavMenu?.();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          window.closeNavMenu?.();
        }
      });

      document.addEventListener(
        "click",
        (e) => {
          const targetEl = e.target as HTMLElement | null;
          const link = targetEl?.closest<HTMLAnchorElement>("#nav-overlay a, #header-logo");
          if (!link) return;

          const href = link.getAttribute("href");
          const wasOpen = Boolean(navTimeline && navTimeline.progress() > 0);

          pendingScrollCall?.kill();
          window.closeNavMenu?.();

          if (!href || !href.startsWith("#")) return;

          e.preventDefault();
          setActiveNavLink(href);

          if (window.location.hash) {
            history.replaceState(null, "", window.location.pathname + window.location.search);
          }

          if (wasOpen) {
            pendingScrollCall = gsap.delayedCall(SCROLL_DELAY, () => runScroll(href));
          } else {
            runScroll(href);
          }
        },
        true
      );
    }
  }

  initNavigationOverlay();
  document.addEventListener("astro:page-load", initNavigationOverlay);
</script>