---
// src/components/navigation/NavigationOverlay.astro
---

<!-- Fullscreen overlay container (hidden by default using opacity & pointer-events) -->
<div
  id="nav-overlay"
  class="z-40 fixed inset-0 flex flex-col bg-black transition-opacity duration-300 pointer-events-none justify-center items-center  pb-20"
>
  <nav class="flex flex-col items-start gap-10 font-mono font-thin text-white text-3xl mx-auto w-fit lg:w-[80%]">
  <a
    href="#"
    class="nav-link flex items-start  gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
  >
    <span class="text-sm md:text-xl lg:text-2xl w-6 text-left">01</span>
    <span class=" md:text-5xl lg:text-6xl">Home</span>
  </a>

  <a 
    href="#about" 
    class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
  >
    <span class="text-sm md:text-xl lg:text-2xl w-6 text-left">02</span>
    <span class=" md:text-5xl lg:text-6xl">About</span>
  </a>

  <a 
    href="#work" 
    class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
  >
    <span class="text-sm md:text-xl lg:text-2xl w-6 text-left">03</span>
    <span class=" md:text-5xl lg:text-6xl">Work</span>
  </a>

  <a 
    href="#services" 
    class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
  >
    <span class="text-sm md:text-xl lg:text-2xl w-6 text-left">04</span>
    <span class=" md:text-5xl lg:text-6xl">Services</span>
  </a>

  <a 
    href="#contact" 
    class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
  >
    <span class="text-sm md:text-xl lg:text-2xl w-6 text-left">05</span>
    <span class=" md:text-5xl lg:text-6xl">Contact</span>
  </a>
</nav>
  <footer class="bottom-0 fixed p-5 md:p-10 w-[90%] font-span text-white">
    <div class="flex lg:flex-row flex-col justify-between items-center gap-5 p-10 border-white/20 border-t">
      <div class="flex items-center gap-3">
        <!-- Pulsing Dot Container -->
        <span class="relative flex w-3 h-3">
          <span class="inline-flex absolute bg-white opacity-75 rounded-full w-full h-full animate-ping"></span>
          <span class="inline-flex relative bg-white rounded-full w-3 h-3"></span>
        </span>
        <p>Available for new projects.</p>
      </div>

      <div class="flex gap-5 text-white">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Resume
        </a>

        <p>|</p>

        <a
          href="https://github.com/lottjerry"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Github
        </a>

        <p>|</p>

        <a
          href="https://www.linkedin.com/in/jerrylott"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </footer>
</div>

<!-- Script to handle opening/closing based on the hamburger click -->
<script is:inline>
  document.addEventListener("menu-toggle", (e) => {
    const overlay = document.getElementById("nav-overlay");
    const hamburgerBtn = document.getElementById("menu-toggle");
    if (!overlay) return;

    const { isActive } = e.detail;

    if (isActive) {
      // Open Overlay
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      document.body.style.overflow = "hidden"; // Prevent background scrolling
    } else {
      // Close Overlay
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = ""; // Restore scrolling
    }
  });

  // Optional: Close overlay automatically when a link inside it is clicked
  document.querySelectorAll("#nav-overlay a").forEach((link) => {
    link.addEventListener("click", () => {
      const overlay = document.getElementById("nav-overlay");
      const hamburgerBtn = document.getElementById("menu-toggle");

      if (overlay) {
        overlay.classList.remove("opacity-100", "pointer-events-auto");
        overlay.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
      }
      if (hamburgerBtn) {
        hamburgerBtn.classList.remove("is-active");
        hamburgerBtn.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
