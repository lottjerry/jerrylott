---
// src/components/navigation/NavigationOverlay.astro
---

<!-- Fullscreen overlay container (hidden by default using opacity & pointer-events) -->
<div
  id="nav-overlay"
  class="z-40 fixed inset-0 flex flex-col bg-black transition-opacity duration-300 opacity-0 pointer-events-none justify-center items-center pb-20"
>
  <nav class="flex flex-col items-start gap-10 font-mono font-thin text-white text-3xl mx-auto w-fit md:w-[60%]">
    <a
      href="#"
      class="nav-link flex items-start gap-6 opacity-100 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="text-sm md:text-2xl w-6 text-left">01</span>
      <span class="md:text-6xl">Home</span>
    </a>

    <a
      href="#about"
      class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="text-sm md:text-2xl w-6 text-left">02</span>
      <span class="md:text-6xl">About</span>
    </a>

    <a
      href="#work"
      class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="text-sm md:text-2xl w-6 text-left">03</span>
      <span class="md:text-6xl">Work</span>
    </a>

    <a
      href="#services"
      class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="text-sm md:text-2xl w-6 text-left">04</span>
      <span class="md:text-6xl">Services</span>
    </a>

    <a
      href="#contact"
      class="nav-link flex items-start gap-6 opacity-30 hover:opacity-100 transition-opacity duration-300"
    >
      <span class="text-sm md:text-2xl w-6 text-left">05</span>
      <span class="md:text-6xl">Contact</span>
    </a>
  </nav>

  <footer class="bottom-0 fixed p-5 md:p-10 w-[90%] font-span text-white">
    <div class="flex lg:flex-row flex-col justify-between items-center gap-5 p-10 border-white/20 border-t">
      <div class="flex items-center gap-3">
        <!-- Pulsing Dot Container -->
        <span class="relative flex w-3 h-3">
          <span class="inline-flex absolute bg-white opacity-75 rounded-full w-full h-full animate-ping"></span>
          <span class="inline-flex relative bg-white rounded-full w-3 h-3"></span>
        </span>
        <p>Available for new projects.</p>
      </div>

      <div class="flex gap-5 text-white">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Resume
        </a>

        <p>|</p>

        <a
          href="https://github.com/lottjerry"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          Github
        </a>

        <p>|</p>

        <a
          href="https://www.linkedin.com/in/jerrylott"
          target="_blank"
          rel="noopener noreferrer"
          class="relative pb-0.5 after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-full after:origin-bottom-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 hover:after:scale-x-100"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </footer>
</div>

<script is:inline>
  const NAVBAR_OFFSET = -96;
  let activeNavHref = "#";

  function setActiveNavLink(href) {
    activeNavHref = href;
    const links = document.querySelectorAll("#nav-overlay .nav-link");
    links.forEach((link) => {
      const isCurrent = link.getAttribute("href") === href;
      link.classList.toggle("opacity-100", isCurrent);
      link.classList.toggle("opacity-30", !isCurrent);
      if (isCurrent) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  function syncActiveSectionFromScroll() {
    // Near the top of the page -> Home ("#") is active
    if (window.scrollY < window.innerHeight * 0.4) {
      setActiveNavLink("#");
      return;
    }

    // Check which section covers the center of the viewport
    const midY = window.innerHeight * 0.5;
    const sectionIds = ["about", "work", "services", "contact"];
    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (!el) continue;
      const rect = el.getBoundingClientRect();
      if (rect.top <= midY && rect.bottom >= midY) {
        setActiveNavLink(`#${id}`);
        return;
      }
    }
  }

  function syncHamburgerWithOverlay() {
    const overlay = document.getElementById("nav-overlay");
    const btn = document.getElementById("menu-toggle");
    if (!overlay || !btn) return;

    const isOpen = overlay.classList.contains("opacity-100");
    btn.classList.toggle("is-active", isOpen);
    btn.setAttribute("aria-expanded", String(isOpen));
  }

  function openMenu() {
    const overlay = document.getElementById("nav-overlay");
    if (!overlay) return;

    syncActiveSectionFromScroll();
    overlay.classList.remove("opacity-0", "pointer-events-none");
    overlay.classList.add("opacity-100", "pointer-events-auto");
    document.body.style.overflow = "hidden";
    window.smoothScrollLenis?.stop();
    syncHamburgerWithOverlay();
  }

  window.closeNavMenu = function () {
    const overlay = document.getElementById("nav-overlay");
    if (!overlay) return;

    overlay.classList.remove("opacity-100", "pointer-events-auto");
    overlay.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
    window.smoothScrollLenis?.start();
    syncHamburgerWithOverlay();
  };

  function initNavigationOverlay() {
    const overlay = document.getElementById("nav-overlay");
    if (!overlay) return;

    // Watch #nav-overlay classes so the hamburger icon ALWAYS stays in sync
    if (!overlay.dataset.observed) {
      overlay.dataset.observed = "true";
      const observer = new MutationObserver(syncHamburgerWithOverlay);
      observer.observe(overlay, { attributes: true, attributeFilter: ["class"] });
    }

    // Observe sections as the user scrolls
    const sectionIds = ["about", "work", "services", "contact"];
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        if (window.scrollY < window.innerHeight * 0.4) {
          setActiveNavLink("#");
          return;
        }
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveNavLink(`#${entry.target.id}`);
          }
        });
      },
      {
        rootMargin: "-40% 0px -40% 0px",
        threshold: 0,
      }
    );

    sectionIds.forEach((id) => {
      const section = document.getElementById(id);
      if (section) sectionObserver.observe(section);
    });

    // Ensure Home re-activates when scrolling all the way back up
    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY < window.innerHeight * 0.4 && activeNavHref !== "#") {
          setActiveNavLink("#");
        }
      },
      { passive: true }
    );

    syncActiveSectionFromScroll();

    if (!window.__navListenersBound) {
      window.__navListenersBound = true;

      document.addEventListener("menu-toggle", (e) => {
        if (e.detail?.isActive) {
          openMenu();
        } else {
          window.closeNavMenu();
        }
      });

      // Handle both #nav-overlay links AND #header-logo in one place
      document.addEventListener(
        "click",
        (e) => {
          const link = e.target.closest("#nav-overlay a, #header-logo");
          if (!link) return;

          const href = link.getAttribute("href");
          window.closeNavMenu();

          if (!href || !href.startsWith("#")) return;

          e.preventDefault();
          history.replaceState(null, "", href);
          setActiveNavLink(href);

          const target = href === "#" ? 0 : href;
          const offset = href === "#" ? 0 : NAVBAR_OFFSET;

          if (window.smoothScrollLenis) {
            window.smoothScrollLenis.start();
            window.smoothScrollLenis.scrollTo(target, { offset, force: true });
          } else if (href === "#") {
            window.scrollTo({ top: 0, behavior: "smooth" });
          } else {
            document.querySelector(href)?.scrollIntoView({ behavior: "smooth" });
          }
        },
        true
      );
    }
  }

  initNavigationOverlay();
  document.addEventListener("astro:page-load", initNavigationOverlay);
</script>