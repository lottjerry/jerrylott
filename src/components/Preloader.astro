---
// src/components/Preloader.astro
---

<!-- 1. Critical inline styles guarantee solid black full-screen cover BEFORE external CSS/JS loads -->
<div
  id="preloader-curtain"
  aria-hidden="false"
  style="
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    z-index: 9998;
    pointer-events: auto;
    clip-path: inset(0% 0% 0% 0%);
  "
></div>

<!-- 2. Persistent bottom-right SVG circle (starts above curtain at z-index: 9999, drops to z-30 after load) -->
<div
  id="scroll-progress-widget"
  class="fixed bottom-4 right-4 md:bottom-6 md:right-6 lg:bottom-8 lg:right-8 flex items-center justify-center pointer-events-none select-none mix-blend-difference"
  style="
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  "
>
  <svg
    class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 -rotate-90"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <!-- Subtle background track -->
    <circle
      cx="50"
      cy="50"
      r="44"
      fill="none"
      stroke="rgba(255, 255, 255, 0.2)"
      stroke-width="2.5"
    />
    <!-- Animated white progress border -->
    <circle
      id="progress-ring"
      cx="50"
      cy="50"
      r="44"
      fill="none"
      stroke="#ffffff"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-dasharray="276.46"
      stroke-dashoffset="276.46"
    />
  </svg>

  <span
    id="progress-percent"
    class="absolute font-mono text-[10px] md:text-xs tracking-tight text-white"
    style="position: absolute; color: #ffffff;"
  >
    0%
  </span>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  declare global {
    interface Window {
      preloaderRevealed?: boolean;
    }
  }

  const CIRCUMFERENCE = 2 * Math.PI * 44; // ~276.46
  let scrollTrackerTrigger: ScrollTrigger | null = null;

  function signalHeroReveal() {
    if (window.preloaderRevealed) return;
    window.preloaderRevealed = true;
    window.dispatchEvent(new CustomEvent("preloader:reveal"));
  }

  function updateCircleUI(
    ring: SVGCircleElement,
    percentEl: HTMLElement,
    value: number
  ) {
    const clamped = Math.max(0, Math.min(100, value));
    percentEl.textContent = `${Math.round(clamped)}%`;
    const offset = CIRCUMFERENCE - (clamped / 100) * CIRCUMFERENCE;
    ring.style.strokeDashoffset = `${offset}`;
  }

  function dropWidgetBelowNav(widget: HTMLElement) {
    // Clear inline positioning/z-index so Tailwind responsive classes & z-30 take over
    widget.style.bottom = "";
    widget.style.right = "";
    widget.style.zIndex = "30";
  }

  function initScrollTracker(
    ring: SVGCircleElement,
    percentEl: HTMLElement
  ) {
    scrollTrackerTrigger?.kill();

    scrollTrackerTrigger = ScrollTrigger.create({
      trigger: document.documentElement,
      start: "top top",
      end: "bottom bottom",
      scrub: true,
      onUpdate: (self) => {
        updateCircleUI(ring, percentEl, self.progress * 100);
      },
    });
  }

  function initPreloaderAndScrollTracker() {
    const curtain = document.getElementById("preloader-curtain");
    const widget = document.getElementById("scroll-progress-widget");
    const ring = document.getElementById("progress-ring") as SVGCircleElement | null;
    const percentEl = document.getElementById("progress-percent");

    if (!widget || !ring || !percentEl) return;

    ring.style.strokeDasharray = `${CIRCUMFERENCE}`;

    // If preloader already ran (e.g. after a View Transition), reveal hero & bind scroll tracking
    if (!curtain || curtain.dataset.played === "true") {
      dropWidgetBelowNav(widget);
      signalHeroReveal();
      initScrollTracker(ring, percentEl);
      return;
    }

    curtain.dataset.played = "true";

    // Lock scroll while loading
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
    window.smoothScrollLenis?.stop();

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (prefersReducedMotion) {
      curtain.style.display = "none";
      curtain.setAttribute("aria-hidden", "true");
      dropWidgetBelowNav(widget);
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      window.smoothScrollLenis?.start();
      updateCircleUI(ring, percentEl, 0);
      signalHeroReveal();
      initScrollTracker(ring, percentEl);
      return;
    }

    const counter = { value: 0 };

    const tl = gsap.timeline({
      onComplete: () => {
        curtain.style.display = "none";
        curtain.setAttribute("aria-hidden", "true");
        dropWidgetBelowNav(widget);

        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
        window.smoothScrollLenis?.start();

        initScrollTracker(ring, percentEl);
        ScrollTrigger.refresh();
      },
    });

    // 1. Load from 0% -> 100%
    tl.to(counter, {
      value: 100,
      duration: 1.5,
      ease: "power2.inOut",
      onUpdate: () => updateCircleUI(ring, percentEl, counter.value),
    })
      // 2. Roll up the black curtain and notify the Hero section
      .to(
        curtain,
        {
          clipPath: "inset(0% 0% 100% 0%)",
          duration: 0.75,
          ease: "power4.inOut",
          onStart: () => {
            gsap.delayedCall(0.15, signalHeroReveal);
          },
        },
        "+=0.1"
      )
      // 3. Simultaneously drain circle back to 0% for the top of the page
      .to(
        counter,
        {
          value: 0,
          duration: 0.65,
          ease: "power3.inOut",
          onUpdate: () => updateCircleUI(ring, percentEl, counter.value),
        },
        "<"
      );
  }

  initPreloaderAndScrollTracker();
  document.addEventListener("astro:page-load", initPreloaderAndScrollTracker);
</script>