---
// src/components/Footer.astro
---

<footer
  id="site-footer"
  class="relative font-mono bg-black text-white font-bold flex flex-col justify-center items-center text-[0.625rem] p-10 md:flex-row md:justify-around md:text-base gap-3"
>
  <!-- Center-expanding top rule -->
  <span
    id="footer-top-line"
    class="absolute top-0 left-0 right-0 h-px bg-white origin-center"
  ></span>

  <p class="footer-item">
    © 2026 JERRY LOTT. ALL RIGHTS RESERVED.
  </p>
  <p class="footer-item">
    DESIGNED BY CUSTOM D3.
  </p>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let footerTimeline: gsap.core.Timeline | null = null;

  function initFooterAnimations() {
    const footer = document.getElementById("site-footer");
    if (!footer) return;

    footerTimeline?.scrollTrigger?.kill();
    footerTimeline?.kill();

    const topLine = document.getElementById("footer-top-line");
    const items = gsap.utils.toArray<HTMLElement>("#site-footer .footer-item");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set([topLine, items], { clearProps: "all" });
      return;
    }

    gsap.set(topLine, { scaleX: 0 });
    gsap.set(items, { y: 8, opacity: 0 });

    footerTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: footer,
        start: "top bottom",
        once: true,
      },
    });

    footerTimeline
      .to(topLine, {
        scaleX: 1,
        duration: 0.85,
        ease: "power3.inOut",
      })
      .to(
        items,
        {
          y: 0,
          opacity: 1,
          duration: 0.5,
          ease: "power3.out",
          stagger: 0.1,
          clearProps: "transform,opacity",
        },
        "-=0.4"
      );
  }

  if (document.readyState === "complete") {
    initFooterAnimations();
  } else {
    window.addEventListener("load", initFooterAnimations, { once: true });
  }
  document.addEventListener("astro:page-load", initFooterAnimations);
</script>